---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Karolina Gorna – Cybersecurity researcher, PhD candidate at Télécom Paris & Ledger Donjon" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Karolina GORNA</title>
  </head>
  <body class="flex min-h-screen flex-col bg-brand-bg font-sans text-brand-body antialiased">
    <div class="h-1 w-full bg-gradient-to-r from-accent-blue via-accent-cyan to-accent-green"></div>
    <Nav />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6">
      <slot />
    </main>
    <Footer />
    <script>
      // Give every section heading a stable id and a GitHub-style "#" anchor
      // that copies the section URL. Runs at build-free page load; headings
      // inside interactive islands or cards are skipped.
      function slugify(s: string): string {
        return s
          .toLowerCase()
          .trim()
          .replace(/[^\w\s-]/g, "")
          .replace(/[\s_]+/g, "-")
          .replace(/-+/g, "-")
          .replace(/^-|-$/g, "");
      }

      function initHeadingAnchors() {
        const main = document.querySelector("main");
        if (!main) return;
        const heads = main.querySelectorAll<HTMLElement>("h2, h3");
        heads.forEach((h) => {
          if (h.closest("astro-island") || h.closest("article")) return;
          if (h.querySelector(".heading-anchor")) return;
          const label = (h.getAttribute("data-text") || h.textContent || "").trim();
          if (!label) return;

          let id = h.id || slugify(label);
          if (!id) return;
          let unique = id;
          let n = 2;
          while (!h.id && document.getElementById(unique)) {
            unique = id + "-" + n++;
          }
          h.id = unique;

          const a = document.createElement("a");
          a.className = "heading-anchor";
          a.href = "#" + unique;
          a.setAttribute("aria-label", "Copy link to this section: " + label);
          a.textContent = "#";
          a.addEventListener("click", () => {
            const url = location.origin + location.pathname + "#" + unique;
            if (navigator.clipboard) {
              navigator.clipboard.writeText(url).catch(() => {});
              a.classList.add("is-copied");
              window.setTimeout(() => a.classList.remove("is-copied"), 1300);
            }
            // default anchor navigation still updates the hash and scrolls
          });
          h.appendChild(a);
        });

        // Ids are added after load, so honour an incoming #hash now.
        if (location.hash.length > 1) {
          const target = document.getElementById(
            decodeURIComponent(location.hash.slice(1)),
          );
          if (target) target.scrollIntoView();
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHeadingAnchors);
      } else {
        initHeadingAnchors();
      }
    </script>
  </body>
</html>
