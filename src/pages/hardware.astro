        </g>
        <g class="c-purple badge"><circle cx="456" cy="89" r="9"/><text class="ts" x="456" y="89" text-anchor="middle" dominant-baseline="central">0</text></g>
        <g class="c-gray">
          <rect x="485" y="80" width="115" height="55" rx="10" stroke-width="1"/>
          <text class="th" x="542.5" y="98" text-anchor="middle" dominant-baseline="central">Reset ctrl</text>
