        <text class="ts" x="341" y="118" text-anchor="middle" dominant-baseline="central" fill="#791f1f" style="font-size:11px">vendor cert or MOK</text>
        <path d="M254 170 L254 100 L557 100 L557 168" stroke="#a32d2d" stroke-width="1.8" fill="none" marker-end="url(#abig5)"/>
        <text class="ts" x="405" y="88" text-anchor="middle" dominant-baseline="central" fill="#791f1f" style="font-size:11px">checks the kernel when GRUB asks</text>
        <path d="M781 170 L781 130 L885 130 L885 168" stroke="#a32d2d" stroke-width="1.8" stroke-dasharray="5 3" fill="none" marker-end="url(#abig5)"/>
        <text class="ts" x="833" y="118" text-anchor="middle" dominant-baseline="central" fill="#791f1f" style="font-size:11px">dm-verity, if used</text>

