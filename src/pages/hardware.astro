        </g>
        <g class="c-purple badge"><circle cx="591" cy="89" r="9"/><text class="ts" x="591" y="89" text-anchor="middle" dominant-baseline="central">0</text></g>

        <path d="M137.5 65 L137.5 72 L30 72 L30 245 L137.5 245 L137.5 255" class="wire-debug"/>
