        </g>
        <g class="c-purple badge"><circle cx="591" cy="264" r="9"/><text class="ts" x="591" y="264" text-anchor="middle" dominant-baseline="central">2</text></g>

        <line x1="485" y1="300" x2="465" y2="300" class="arr" marker-end="url(#arrow)"/>
        <line x1="350" y1="300" x2="330" y2="300" class="arr" marker-end="url(#arrow)"/>
        <path d="M272.5 345 L160 375" class="arr" marker-end="url(#arrow)" fill="none"/>
