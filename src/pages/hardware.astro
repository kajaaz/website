---
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  {
    n: "0",
    title: "Always-on hardware",
    body: "The CPU, Trusted ROM and on-chip Trusted SRAM are not steps: ROM holds the first code, and SRAM is where BL1's data, BL2 and BL31 run.",
  },
  {
    n: "1",
    title: "Reset",
    body: "The primary core leaves reset at the reset vector in Trusted ROM; the other cores wait until the OS starts them through BL31 (PSCI CPU_ON).",
  },
  {
    n: "2",
    title: "BL1, Trusted ROM (EL3)",
    body: "Immutable code sets up the exception vectors, the watchdog, the console and the MMU, copies BL2 into Trusted SRAM, then verifies that copy against the root-key hash in OTP, in software or with a crypto engine. Checking the copy, not the flash, ensures the verified bytes are the ones that run. With measured boot it also hashes BL2 into the TPM; BL1 is the root of trust for measurement, so nothing measures BL1 itself.",
  },
  {
    n: "3",
    title: "BL2, Trusted Boot Firmware (Secure-EL1 or EL3)",
    body: "Initialises DRAM on most real SoCs, programs the TrustZone controller to split memory and peripherals into secure and non-secure, then loads and verifies BL31, BL32 and BL33 from the Firmware Image Package (FIP) in flash. It runs at EL3 when a vendor boot ROM loads it directly, as on the vendor chips below. With measured boot it also measures each image it loads and passes the event log on to BL33 and the OS.",
  },
  {
    n: "4",
    title: "BL31, EL3 runtime",
    body: "The resident secure monitor: sets up the interrupt controller and PSCI power management, and handles Secure Monitor Calls (SMC) from the normal world for the life of the system.",
  },
  {
    n: "5",
    title: "BL32, Trusted OS (Secure-EL1, optional)",
    body: "A Trusted OS such as OP-TEE, reached through BL31 and usually running in secure DRAM. On AArch32 there is no BL31 and BL32 is also the monitor.",
  },
  {
    n: "6",
    title: "BL33, Non-trusted firmware (EL2/EL1)",
    body: "The first non-secure code, usually U-Boot or UEFI, running from DRAM; it boots the OS. TF-A's chain of trust ends here: BL33 must verify the kernel itself (signed FIT images or UEFI Secure Boot).",
  },
];

// TF-A stages are flagged true; vendor or third-party stages false.
