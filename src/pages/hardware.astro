      <figcaption class="mt-3 text-sm text-brand-muted">
        Numbered badges (0 to 8) trace the main execution sequence. Unbadged blocks are supporting infrastructure
        without a single fixed step in the sequence.
      </figcaption>
    </figure>

    <!-- Step by step -->
    <h3 class="mb-4 mt-10 text-lg font-semibold text-brand-text">Step by step</h3>
    <ol class="space-y-4">
      {steps.map((s) => (
        <li class="flex gap-3">
          <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full font-mono text-xs font-semibold text-white" style="background:#534AB7">{s.n}</span>
          <p class="leading-relaxed text-brand-body"><strong class="text-brand-text">{s.title}.</strong> {s.body}</p>
        </li>
      ))}
    </ol>

    <!-- Two connections -->
    <h3 class="mb-3 mt-10 text-lg font-semibold text-brand-text">Two connections worth calling out</h3>
    <ul class="ml-5 list-disc space-y-3 marker:text-accent-green">
      {connections.map((c) => (
        <li class="leading-relaxed text-brand-body"><strong class="text-brand-text">{c.title}</strong> {c.body}</li>
      ))}
    </ul>

    <p class="mt-8 rounded-lg border border-brand-border bg-brand-bg px-4 py-3 text-sm leading-relaxed text-brand-muted">
      Note: TrustZone, attestation, the interrupt controller and UART don't have one universal ordering the way
      steps 1 to 8 do: real designs vary in exactly when each gets configured. They're shown in one plausible order
      here for clarity, not as a claim about a fixed sequence.
    </p>
  </section>
</BaseLayout>

