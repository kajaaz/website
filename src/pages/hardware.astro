  { name: "ST STM32MP25", url: "https://trustedfirmware-a.readthedocs.io/en/latest/plat/st/stm32mpus.html", chain: [["ROM", false], ["BL2", true], ["BL31", true], ["OP-TEE", false], ["U-Boot", false]] },
  { name: "Renesas R-Car Gen3", url: "https://trustedfirmware-a.readthedocs.io/en/latest/plat/rcar-gen3.html", chain: [["ROM", false], ["BL2", true], ["BL31", true], ["OP-TEE", false], ["U-Boot", false]] },
  { name: "NXP Layerscape", url: "https://trustedfirmware-a.readthedocs.io/en/v2.6/plat/nxp/nxp-layerscape.html", chain: [["ROM", false], ["BL2", true], ["BL31", true], ["OP-TEE", false], ["U-Boot", false]] },
