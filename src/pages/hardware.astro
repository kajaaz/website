        {kbBoxes.slice(1).map((_, i) => (
          <line x1={kbX(i) + 141} y1="205" x2={kbX(i + 1) - 2} y2="205" stroke="#334155" stroke-width="2" marker-end="url(#abig5)"/>
        ))}

        <!-- Secure Boot checks -->
        <path d="M125 170 L125 130 L229 130 L229 168" stroke="#a32d2d" stroke-width="1.8" fill="none" marker-end="url(#abig5)"/>
        <text class="ts" x="177" y="118" text-anchor="middle" dominant-baseline="central" fill="#791f1f" style="font-size:11px">checks db, dbx</text>
