---
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  {
    n: "0",
    title: "Always-on hardware",
    body: "The CPU, Trusted ROM and on-chip Trusted SRAM are not steps: ROM holds the first code, and SRAM is where BL1's data, BL2 and BL31 run.",
  },
  {
    n: "1",
    title: "Reset",
    body: "The primary core leaves reset at the reset vector in Trusted ROM; the other cores wait until the OS starts them through BL31 (PSCI CPU_ON).",
  },
  {
    n: "2",
    title: "BL1, Trusted ROM (EL3)",
    body: "Immutable code sets up the exception vectors, the watchdog, the console and the MMU, copies BL2 into Trusted SRAM, then verifies that copy against the root-key hash in OTP, in software or with a crypto engine. Checking the copy, not the flash, ensures the verified bytes are the ones that run.",
  },
  {
    n: "3",
    title: "BL2, Trusted Boot Firmware (Secure-EL1 or EL3)",
    body: "Initialises DRAM on most real SoCs, programs the TrustZone controller to split memory and peripherals into secure and non-secure, then loads and verifies BL31, BL32 and BL33 from the Firmware Image Package (FIP) in flash. It runs at EL3 when a vendor boot ROM loads it directly, as on the vendor chips below.",
  },
  {
    n: "4",
    title: "BL31, EL3 runtime",
    body: "The resident secure monitor: sets up the interrupt controller and PSCI power management, and handles Secure Monitor Calls (SMC) from the normal world for the life of the system.",
  },
  {
    n: "5",
    title: "BL32, Trusted OS (Secure-EL1, optional)",
    body: "A Trusted OS such as OP-TEE, reached through BL31 and usually running in secure DRAM. On AArch32 there is no BL31 and BL32 is also the monitor.",
  },
  {
    n: "6",
    title: "BL33, Non-trusted firmware (EL2/EL1)",
    body: "The first non-secure code, usually U-Boot or UEFI, running from DRAM; it boots the OS. TF-A's chain of trust ends here: BL33 must verify the kernel itself (signed FIT images or UEFI Secure Boot).",
  },
];

// TF-A stages are flagged true; vendor or third-party stages false.
const chainRows: { name: string; url: string; chain: [string, boolean][] }[] = [
  { name: "Arm Juno / FVP", url: "https://trustedfirmware-a.readthedocs.io/en/latest/plat/arm/juno/index.html", chain: [["BL1", true], ["BL2", true], ["BL31", true], ["OP-TEE", false], ["U-Boot", false]] },
  { name: "ST STM32MP25", url: "https://trustedfirmware-a.readthedocs.io/en/latest/plat/st/stm32mpus.html", chain: [["ROM", false], ["BL2", true], ["BL31", true], ["OP-TEE", false], ["U-Boot", false]] },
  { name: "Renesas R-Car Gen3", url: "https://trustedfirmware-a.readthedocs.io/en/latest/plat/rcar-gen3.html", chain: [["ROM", false], ["BL2", true], ["BL31", true], ["OP-TEE", false], ["U-Boot", false]] },
  { name: "NXP Layerscape", url: "https://trustedfirmware-a.readthedocs.io/en/v2.6/plat/nxp/nxp-layerscape.html", chain: [["ROM", false], ["BL2", true], ["BL31", true], ["OP-TEE", false], ["U-Boot", false]] },
  { name: "ST STM32MP15", url: "https://trustedfirmware-a.readthedocs.io/en/latest/plat/st/stm32mpus.html", chain: [["ROM", false], ["BL2", true], ["OP-TEE", false], ["U-Boot", false]] },
  { name: "NXP i.MX 8M", url: "https://trustedfirmware-a.readthedocs.io/en/stable/plat/imx8m.html", chain: [["ROM", false], ["SPL", false], ["BL31", true], ["U-Boot", false]] },
];

// Each "used" / "brk" item is [text, source url].
type Ref = [string, string];
const chips: {
  chip: string; cpu: string; rom: string; key: string; tz: string; tfa: string;
  used: Ref[]; brk: Ref[]; src: Ref[];
}[] = [
  {
    chip: "Arm Juno / FVP", cpu: "Cortex-A72 or A57 (+ A53)", rom: "No vendor ROM: TF-A BL1 (in flash) verifies BL2, RSA or ECDSA",
    key: "Read-only registers (fixed key hash; no OTP)", tz: "Yes", tfa: "BL1, BL2, BL31 (full chain)",
    used: [
      ["Arm's reference development board", "https://trustedfirmware-a.readthedocs.io/en/latest/plat/arm/juno/index.html"],
      ["FVP software model", "https://trustedfirmware-a.readthedocs.io/en/latest/plat/arm/fvp/index.html"],
    ],
    brk: [],
    src: [
      ["Juno key storage", "https://support.arm.com/documentation/dto0038/c/hardware-functional-description/trusted-execution-environment--tee-/trusted-key-storage"],
      ["TF-A build options", "https://trustedfirmware-a.readthedocs.io/en/latest/plat/arm/arm-build-options.html"],
    ],
  },
  {
    chip: "ST STM32MP25", cpu: "Cortex-A35 (+ M33)", rom: "TF-A BL2, ECDSA (P-256 / Brainpool)", key: "OTP (key-table hash)",
    tz: "Yes", tfa: "BL2, BL31",
    used: [["Digi ConnectCore MP25 industrial edge-AI module", "https://www.digi.com/products/embedded-systems/digi-connectcore/system-on-modules/digi-connectcore-mp2"]],
    brk: [],
    src: [
      ["ST wiki", "https://wiki.st.com/stm32mpu/wiki/STM32_MPU_ROM_code_secure_boot"],
      ["TF-A", "https://trustedfirmware-a.readthedocs.io/en/latest/plat/st/stm32mpus.html"],
    ],
  },
  {
    chip: "Renesas R-Car Gen3", cpu: "Cortex-A57 and/or A53 (+ R7)", rom: "TF-A BL2, RSA certificates", key: "Fuses (customer's root-key hash, programmed by Renesas)",
    tz: "Yes", tfa: "BL2, BL31",
    used: [
      ["Toyota / Lexus multimedia (Lexus NX, 2021)", "https://www.renesas.com/en/about/newsroom/renesas-innovative-automotive-chips-drive-next-generation-multimedia-system-toyota-lexus"],
      ["Parrot Faurecia cockpit", "https://www.renesas.com/en/about/press-room/renesas-and-opensynergy-adopted-parrot-faurecia-automotive-s-safe-multi-display-cockpit"],
    ],
    brk: [],
    src: [
      ["Renesas", "https://www.renesas.com/en/blogs/achieving-root-trust-secure-boot-automotive-rh850-and-r-car-devices-part-3"],
      ["TF-A", "https://trustedfirmware-a.readthedocs.io/en/latest/plat/rcar-gen3.html"],
    ],
  },
  {
    chip: "NXP Layerscape LX2160A", cpu: "16× Cortex-A72", rom: "TF-A BL2, RSA (CSF header)", key: "Fuses (SRK hash)",
    tz: "Yes", tfa: "BL2, BL31",
    used: [["SolidRun HoneyComb LX2 Arm workstation", "https://www.solid-run.com/arm-servers-networking-platforms/honeycomb-servers-workstation/honeycomb-lx2/"]],
    brk: [],
    src: [
      ["TF-A", "https://trustedfirmware-a.readthedocs.io/en/v2.6/plat/nxp/nxp-layerscape.html"],
      ["TF-A secure boot", "https://trustedfirmware-a.readthedocs.io/en/v2.6/plat/nxp/nxp-ls-tbbr.html"],
    ],
  },
  {
    chip: "ST STM32MP15", cpu: "Cortex-A7 (+ M4)", rom: "TF-A BL2, ECDSA (P-256 / Brainpool)", key: "OTP (key hash)",
    tz: "Yes", tfa: "BL2",
    used: [
      ["Kontron industrial / IoT module", "https://www.kontron.com/en/news/kontron-presents-system-on-module-based-on-the-new-stm32mp157-with-three-processor-cores-by-stmicroelectronics/n156087"],
      ["Seeed ODYSSEY module", "https://www.st.com/en/partner-products-and-services/odyssey-stm32mp157c.html"],
    ],
    brk: [],
    src: [
      ["ST wiki", "https://wiki.st.com/stm32mpu/wiki/STM32_MPU_ROM_code_secure_boot"],
      ["TF-A", "https://trustedfirmware-a.readthedocs.io/en/latest/plat/st/stm32mpus.html"],
    ],
  },
  {
    chip: "NXP i.MX 8M", cpu: "Cortex-A53 (+ M4 or M7)", rom: "U-Boot SPL, RSA (HABv4)", key: "eFuses (SRK hash)",
    tz: "Yes", tfa: "BL31",
    used: [
      ["Google Coral Dev Board", "https://www.coral.ai/docs/dev-board/datasheet"],
      ["Purism Librem 5 phone", "https://docs.puri.sm/Hardware/Librem_5/overview/specs.html"],
    ],
    brk: [],
    src: [
      ["U-Boot HABv4", "https://github.com/nxp-imx/uboot-imx/blob/lf_v2025.04/doc/imx/habv4/introduction_habv4.txt"],
      ["TF-A", "https://trustedfirmware-a.readthedocs.io/en/stable/plat/imx8m.html"],
    ],
  },
  {
    chip: "NVIDIA Tegra X1", cpu: "Cortex-A57 (+ A53)", rom: "BCT + bootloader, RSA or AES-CMAC; ROM runs on an ARM7 boot CPU", key: "Fuses (RSA key hash, or AES Secure Boot Key)",
    tz: "Yes", tfa: "BL31 (upstream port deprecated in 2026)",
    used: [
      ["Nintendo Switch (own secure monitor, not TF-A)", "https://switchbrew.github.io/34c3-slides/"],
      ["NVIDIA Shield TV (2015, 2017)", "https://www.xda-developers.com/nvidia-shield-tv-pro-shield-tv-stick-announced/"],
      ["Jetson Nano", "https://wiki.lineageos.org/devices/porg_tab/variant2/"],
    ],
    brk: [["Fusée Gelée (2018): USB bug in the boot ROM, unpatchable on shipped chips", "https://web.archive.org/web/20250710125856/https://ktemkin.com/post/fusee_gelee/"]],
    src: [
      ["NVIDIA", "https://download.nvidia.com/tegra-public-appnotes/tegra-boot-flow.html"],
      ["34C3 talk", "https://switchbrew.github.io/34c3-slides/"],
      ["TF-A commit", "https://github.com/ARM-software/arm-trusted-firmware/commits/master/plat/nvidia/tegra/soc/t210"],
    ],
  },
  {
    chip: "Raspberry Pi 5 (BCM2712)", cpu: "Cortex-A76", rom: "Bootloader, RSA-2048, signed by Raspberry Pi and counter-signed by the customer", key: "OTP (customer key hash)",
    tz: "In the cores, but no secure memory controller", tfa: "Minimal BL31, not secure",
    used: [["Raspberry Pi 5, Pi 500, Compute Module 5", "https://github.com/raspberrypi/usbboot/blob/master/secure-boot-recovery5/README.md"]],
    brk: [],
    src: [
      ["Pi secure boot", "https://github.com/raspberrypi/usbboot/blob/master/docs/secure-boot.md"],
      ["TF-A", "https://trustedfirmware-a.readthedocs.io/en/latest/plat/rpi5.html"],
    ],
  },
  {
    chip: "Raspberry Pi RP2350", cpu: "Cortex-M33 (+ Hazard3 RISC-V)", rom: "Signed image, ECDSA secp256k1 + SHA-256", key: "OTP (key hash)",
    tz: "TrustZone-M", tfa: "None",
    used: [["Raspberry Pi Pico 2", "https://www.raspberrypi.com/products/rp2350/"]],
    brk: [
      ["OTP power glitch (Aedan Cullen)", "https://github.com/aedancullen/hacking-the-rp2350"],
      ["voltage and laser fault injection", "https://www.raspberrypi.com/news/security-through-transparency-rp2350-hacking-challenge-results-are-in/"],
      ["FIB readout of the OTP (IOActive)", "https://www.ioactive.com/wp-content/uploads/2025/01/IOActive-RP2350HackingChallenge.pdf"],
    ],
    src: [
      ["Pi white paper", "https://pip-assets.raspberrypi.com/categories/1214-rp2350/documents/RP-009377-WP-1-Understanding%20RP2350_s%20security%20features.pdf"],
    ],
  },
  {
    chip: "ST STM32L431", cpu: "Cortex-M4", rom: "Nothing; ST's X-CUBE-SBSFU adds a software secure boot in flash", key: "—",
    tz: "No", tfa: "None",
    used: [
      ["Hermetis LoRa air-quality sensor", "https://hackaday.io/project/189644-hermetis/details"],
      ["Andrew Zonenberg's lab hardware", "https://web.archive.org/web/20250513070742/https://serd.es/2025/01/02/STM32L431-teardown.html"],
    ],
    brk: [],
    src: [["X-CUBE-SBSFU", "https://www.st.com/en/embedded-software/x-cube-sbsfu.html"]],
  },
  {
    chip: "Espressif ESP32", cpu: "Xtensa LX6 (not Arm)", rom: "Bootloader, AES-based digest (Secure Boot v1); v3 silicon adds RSA-3072 (Secure Boot v2)", key: "eFuses (AES key for v1, RSA key hash for v2)",
    tz: "No", tfa: "None",
    used: [["Shelly Plus 1 smart relay", "https://devices.esphome.io/devices/shelly-plus-1/"]],
    brk: [
      ["Fault injection skips the Secure Boot check (CVE-2019-15894)", "https://www.espressif.com/en/news/Espressif_Security_Advisory_Concerning_Fault_Injection_and_Secure_Boot"],
      ["Voltage glitching read the eFuse keys (2019)", "https://limitedresults.com/results/pwn-the-esp32-forever-flash-encryption-and-sec-boot-keys-extraction"],
      ["CVE-2019-17391 advisory", "https://www.espressif.com/en/news/Security_Advisory_Concerning_Fault_Injection_and_eFuse_Protections"],
      ["One EM glitch via the ROM's UART download mode (Raelize, CVE-2020-13629)", "https://raelize.com/blog/espressif-esp32-bypassing-encrypted-secure-boot-cve-2020-13629/"],
    ],
    src: [["Espressif", "https://docs.espressif.com/projects/esp-idf/en/stable/esp32/security/secure-boot-v1.html"]],
  },
];

const link = "text-accent-blue underline underline-offset-2 transition-colors hover:text-accent-emerald";
---

<BaseLayout title="Hardware" toc>
  <p class="mono-eyebrow mb-1"><span class="text-accent-blue">$</span> dmesg | grep -i boot</p>
  <h1 class="glitch is-intro mb-4 text-3xl font-bold tracking-tight text-brand-text" data-text="Hardware">Hardware</h1>

  <!-- What is it? -->
  <div class="mb-10 rounded-xl bg-accent-green/15 p-5 sm:p-6">
    <h2 class="mb-1 text-sm font-bold text-brand-text">What is it?</h2>
    <p class="text-sm leading-relaxed text-brand-body">
      A cheat sheet on what an Arm chip does between power-on and the OS: the TF-A secure boot chain, the hardware it
      relies on, and how common chips compare.
    </p>
  </div>

  <!-- ====== SECURE BOOT ====== -->
  <section class="mb-14">
    <p class="mono-eyebrow mb-2">// power-on --&gt; chain of trust</p>
    <h2 class="glitch mb-4 text-xl font-semibold text-brand-text" data-text="Anatomy of a secure boot">Anatomy of a secure boot</h2>
    <p class="mb-6 text-brand-body">
      The{" "}
      <a href="https://trustedfirmware-a.readthedocs.io/en/latest/design/firmware-design.html" target="_blank" rel="noopener noreferrer" class={link}>Trusted Firmware-A (TF-A)</a>{" "}
      cold boot, from the reset vector in ROM to the OS: BL1 verifies BL2, then BL2 verifies every BL3x image.{" "}
      <strong class="text-brand-text">BL</strong> stands for Boot Loader stage.
    </p>

    <figure class="mb-8 overflow-x-auto rounded-xl border border-brand-border bg-white p-4 sm:p-6">
      <svg viewBox="0 0 1000 1040" class="soc-svg mx-auto block h-auto w-full max-w-[980px] min-w-[900px]" role="img" aria-labelledby="soc-uni-title soc-uni-desc">
        <title id="soc-uni-title">TF-A secure boot chain, the hardware it uses, and real chips that run it</title>
        <desc id="soc-uni-desc">On the left, a list of real chips and the boot stages they run, with TF-A stages highlighted. In the middle, cards for the CPU, PLL, watchdog, boot ROM, OTP fuses, crypto engine, Trusted SRAM, flash and DRAM, each with an arrow to the boot stage it serves. On the right, the Reset, BL1, BL2, BL31, BL32, BL33 spine. A verification-failure branch halts the SoC, a dashed line marks the secure/normal world boundary, and the operating system starts once BL33 runs.</desc>
        <defs>
          <marker id="abig" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1.5 1L8.5 5L1.5 9" fill="none" stroke="context-stroke" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </marker>
        </defs>

        <!-- top labels -->
        <text class="divider-label" x="24" y="40">This chain on real chips</text>
        <text class="divider-label" x="580" y="40">Hardware it relies on</text>
        <text class="divider-label" x="858" y="40">Boot execution chain</text>

        <!-- ===== Real chips panel ===== -->
        <rect x="24" y="74" width="520" height="350" rx="10" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1"/>
        <rect x="44" y="94" width="10" height="10" rx="2" fill="#0f6e56"/>
        <text class="ts" x="60" y="99" dominant-baseline="central" fill="#334155">TF-A stage</text>
        <rect x="144" y="94" width="10" height="10" rx="2" fill="#94a3b8"/>
        <text class="ts" x="160" y="99" dominant-baseline="central" fill="#334155">vendor or other firmware</text>
        {chainRows.map((r, i) => {
          const y = 140 + i * 38;
          return (
            <g>
              {i > 0 && <line x1="44" y1={y - 19} x2="524" y2={y - 19} stroke="#e2e8f0" stroke-width="1"/>}
              <a href={r.url} target="_blank" rel="noopener noreferrer">
                <text class="chain-name chain-link" x="44" y={y} dominant-baseline="central">{r.name}</text>
              </a>
              <text class="chain" x="232" y={y} dominant-baseline="central">
                {r.chain.map(([label, tfa], j) => (
                  <>
                    {j > 0 && <tspan class="sep">{"\u00a0-->\u00a0"}</tspan>}
                    <tspan class={tfa ? "tfa" : "ven"}>{label}</tspan>
                  </>
                ))}
              </text>
            </g>
          );
        })}
        <text class="ts" x="44" y="384" dominant-baseline="central" fill="#475569">Most SoCs replace BL1 with a vendor boot ROM that verifies the next</text>
        <text class="ts" x="44" y="402" dominant-baseline="central" fill="#475569">stage. TF-A's BL1 also runs, from flash, on Raspberry Pi 3 and HiKey.</text>

        <!-- ===== Boot spine ===== -->
        <g class="c-stage">
          <rect x="858" y="74" width="132" height="54" rx="10" stroke-width="1.4"/>
          <text class="th" x="924" y="96" text-anchor="middle" dominant-baseline="central">Reset</text>
          <text class="ts" x="924" y="113" text-anchor="middle" dominant-baseline="central">power-on</text>
        </g>
        <g class="c-purple badge"><circle cx="978" cy="88" r="9"/><text class="ts" x="978" y="88" text-anchor="middle" dominant-baseline="central">1</text></g>
        <line x1="924" y1="128" x2="924" y2="144" stroke="#334155" stroke-width="2.4" marker-end="url(#abig)"/>

        <g class="c-stage">
          <rect x="858" y="144" width="132" height="264" rx="10" stroke-width="1.4"/>
          <text class="th" x="924" y="172" text-anchor="middle" dominant-baseline="central">BL1</text>
          <text class="ts" x="924" y="190" text-anchor="middle" dominant-baseline="central">Trusted ROM, EL3</text>
          <text class="ts" x="924" y="212" text-anchor="middle" dominant-baseline="central">Brings up the</text>
          <text class="ts" x="924" y="228" text-anchor="middle" dominant-baseline="central">platform, then</text>
          <text class="ts" x="924" y="244" text-anchor="middle" dominant-baseline="central">loads, then</text>
          <text class="ts" x="924" y="260" text-anchor="middle" dominant-baseline="central">verifies BL2.</text>
        </g>
        <g class="c-purple badge"><circle cx="978" cy="158" r="9"/><text class="ts" x="978" y="158" text-anchor="middle" dominant-baseline="central">2</text></g>
        <line x1="924" y1="408" x2="924" y2="424" stroke="#334155" stroke-width="2.4" marker-end="url(#abig)"/>

        <g class="c-stage">
          <rect x="858" y="424" width="132" height="194" rx="10" stroke-width="1.4"/>
          <text class="th" x="924" y="452" text-anchor="middle" dominant-baseline="central">BL2</text>
          <text class="ts" x="924" y="470" text-anchor="middle" dominant-baseline="central">SRAM, S-EL1 or EL3</text>
          <text class="ts" x="924" y="492" text-anchor="middle" dominant-baseline="central">Inits DRAM, locks</text>
          <text class="ts" x="924" y="508" text-anchor="middle" dominant-baseline="central">TrustZone, loads</text>
          <text class="ts" x="924" y="524" text-anchor="middle" dominant-baseline="central">and verifies the</text>
          <text class="ts" x="924" y="540" text-anchor="middle" dominant-baseline="central">BL3x images.</text>
        </g>
        <g class="c-purple badge"><circle cx="978" cy="438" r="9"/><text class="ts" x="978" y="438" text-anchor="middle" dominant-baseline="central">3</text></g>
        <line x1="924" y1="618" x2="924" y2="634" stroke="#334155" stroke-width="2.4" marker-end="url(#abig)"/>

        <g class="c-stage">
          <rect x="858" y="634" width="132" height="64" rx="10" stroke-width="1.4"/>
          <text class="th" x="924" y="660" text-anchor="middle" dominant-baseline="central">BL31</text>
          <text class="ts" x="924" y="678" text-anchor="middle" dominant-baseline="central">EL3 runtime</text>
        </g>
        <g class="c-purple badge"><circle cx="978" cy="648" r="9"/><text class="ts" x="978" y="648" text-anchor="middle" dominant-baseline="central">4</text></g>
        <line x1="924" y1="698" x2="924" y2="714" stroke="#334155" stroke-width="2.4" marker-end="url(#abig)"/>

        <g class="c-stage">
          <rect x="858" y="714" width="132" height="64" rx="10" stroke-width="1.4" stroke-dasharray="5 3"/>
          <text class="th" x="924" y="740" text-anchor="middle" dominant-baseline="central">BL32</text>
          <text class="ts" x="924" y="758" text-anchor="middle" dominant-baseline="central">optional</text>
        </g>
        <g class="c-purple badge"><circle cx="978" cy="728" r="9"/><text class="ts" x="978" y="728" text-anchor="middle" dominant-baseline="central">5</text></g>
        <line x1="924" y1="778" x2="924" y2="800" stroke="#334155" stroke-width="2.4" marker-end="url(#abig)"/>

        <g class="c-stage">
          <rect x="858" y="800" width="132" height="54" rx="10" stroke-width="1.4"/>
          <text class="th" x="924" y="820" text-anchor="middle" dominant-baseline="central">BL33</text>
          <text class="ts" x="924" y="837" text-anchor="middle" dominant-baseline="central">DRAM, EL2/EL1</text>
        </g>
        <g class="c-purple badge"><circle cx="978" cy="814" r="9"/><text class="ts" x="978" y="814" text-anchor="middle" dominant-baseline="central">6</text></g>

        <!-- ===== Hardware / memory cards ===== -->
        <g class="c-gray"><rect x="580" y="74" width="250" height="54" rx="9" stroke-width="1"/>
          <text class="th" x="594" y="95" dominant-baseline="central">CPU cluster</text>
          <text class="ts" x="594" y="112" dominant-baseline="central">Arm cores; run every stage.</text></g>
        <line x1="826" y1="101" x2="857" y2="101" stroke="#444441" stroke-width="2.6" marker-end="url(#abig)"/>

        <g class="c-gray"><rect x="580" y="144" width="250" height="54" rx="9" stroke-width="1"/>
          <text class="th" x="594" y="165" dominant-baseline="central">PLL</text>
          <text class="ts" x="594" y="182" dominant-baseline="central">Multiplies the crystal frequency.</text></g>
        <line x1="826" y1="171" x2="857" y2="171" stroke="#444441" stroke-width="2.6" marker-end="url(#abig)"/>

