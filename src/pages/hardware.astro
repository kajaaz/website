        </g>
        <g class="c-purple badge"><circle cx="186" cy="264" r="9"/><text class="ts" x="186" y="264" text-anchor="middle" dominant-baseline="central">1</text></g>
        <g class="c-coral">
          <rect x="215" y="255" width="115" height="90" rx="12" stroke-width="1"/>
          <text class="th" x="272.5" y="299" text-anchor="middle" dominant-baseline="central">Secure boot</text>
