        </g>
        <g class="c-purple badge"><circle cx="186" cy="384" r="9"/><text class="ts" x="186" y="384" text-anchor="middle" dominant-baseline="central">5</text></g>
        <g class="c-gray">
          <rect x="215" y="375" width="115" height="90" rx="12" stroke-width="1"/>
          <text class="th" x="272.5" y="419" text-anchor="middle" dominant-baseline="central">DMA ctrl</text>
          <text class="ts" x="272.5" y="447" text-anchor="middle" dominant-baseline="central">Moves data</text>
        </g>
        <g class="c-purple badge"><circle cx="321" cy="384" r="9"/><text class="ts" x="321" y="384" text-anchor="middle" dominant-baseline="central">8</text></g>
