        <g class="c-purple badge"><circle cx="321" cy="89" r="9"/><text class="ts" x="321" y="89" text-anchor="middle" dominant-baseline="central">0</text></g>
        <g class="c-pink">
          <rect x="350" y="80" width="115" height="55" rx="10" stroke-width="1"/>
