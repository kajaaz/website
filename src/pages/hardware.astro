          <rect x="485" y="375" width="115" height="90" rx="12" stroke-width="1"/>
          <text class="th" x="542.5" y="419" text-anchor="middle" dominant-baseline="central">MPU / MMU</text>
          <text class="ts" x="542.5" y="447" text-anchor="middle" dominant-baseline="central">Memory perms</text>
        </g>

