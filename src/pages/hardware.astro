        </g>
        <g class="c-purple badge"><circle cx="321" cy="264" r="9"/><text class="ts" x="321" y="264" text-anchor="middle" dominant-baseline="central">6</text></g>
        <g class="c-coral">
          <rect x="350" y="255" width="115" height="90" rx="12" stroke-width="1"/>
          <text class="th" x="407.5" y="299" text-anchor="middle" dominant-baseline="central">OTP/eFuses</text>
          <text class="ts" x="407.5" y="327" text-anchor="middle" dominant-baseline="central">Keys, rollback</text>
        </g>
        <g class="c-purple badge"><circle cx="456" cy="264" r="9"/><text class="ts" x="456" y="264" text-anchor="middle" dominant-baseline="central">3</text></g>
        <g class="c-coral">
          <rect x="485" y="255" width="115" height="90" rx="12" stroke-width="1"/>
          <text class="th" x="542.5" y="299" text-anchor="middle" dominant-baseline="central">Boot ROM</text>
