          <text class="ts" x="272.5" y="567" text-anchor="middle" dominant-baseline="central">Records hashes</text>
        </g>
        <g class="c-gray">
          <rect x="350" y="495" width="115" height="90" rx="12" stroke-width="1"/>
          <text class="th" x="407.5" y="539" text-anchor="middle" dominant-baseline="central">IRQ ctrl</text>
          <text class="ts" x="407.5" y="567" text-anchor="middle" dominant-baseline="central">Handles events</text>
