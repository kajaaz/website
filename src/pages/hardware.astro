            <text class="ts" x={kbX(i) + 70} y="212" text-anchor="middle" dominant-baseline="central" style="font-size:10.5px">{l1}</text>
            <text class="ts" x={kbX(i) + 70} y="226" text-anchor="middle" dominant-baseline="central" style="font-size:10.5px">{l2}</text>
          </g>
