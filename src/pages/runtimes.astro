          <!-- Interpreter path -->
          <rect x="220" y="180" width="130" height="48" rx="9" fill="rgba(190,24,93,0.10)" stroke="#be185d" stroke-width="1.5"/>
          <text x="285" y="202" font-size="12" font-weight="700" fill="#be185d">Interpreter</text>
          <text x="285" y="216" font-size="10" fill="#be185d">CPython, MRI, Bash</text>
          <line x1="140" y1="138" x2="218" y2="198" stroke="#71717A" stroke-width="1.3" marker-end="url(#rt-arrow)"/>

          <rect x="420" y="180" width="120" height="48" rx="9" fill="rgba(190,24,93,0.10)" stroke="#be185d" stroke-width="1.5"/>
          <text x="480" y="202" font-size="12" font-weight="700" fill="#be185d">Executed live</text>
          <text x="480" y="216" font-size="10" fill="#be185d">statement by stmt</text>
          <line x1="350" y1="204" x2="418" y2="204" stroke="#71717A" stroke-width="1.3" marker-end="url(#rt-arrow)"/>

