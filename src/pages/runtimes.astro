                <rect x="124" y="20" width="46" height="20" rx="3" fill="#10B981" fill-opacity="0.15" stroke="#10B981" stroke-width="1"/>
                <text x="147" y="33" text-anchor="middle" font-size="7.5" fill="#047857" font-weight="600">GC</text>
                <rect x="60" y="52" width="120" height="12" rx="3" fill="#9CA3AF" fill-opacity="0.15" stroke="#9CA3AF" stroke-width="0.8"/>
                <text x="120" y="61" text-anchor="middle" font-size="7" fill="#6B7280">any OS / CPU</text>
                <line x1="120" y1="48" x2="120" y2="52" stroke="#9CA3AF" stroke-width="1"/>
              </svg>
            )}

            {m.id === "interpreter" && (
              <svg viewBox="0 0 240 62" class="mx-auto w-full max-w-[240px]" aria-hidden="true">
                <rect x="2" y="6" width="120" height="50" rx="4" fill="#F9FAFB" stroke={m.accent} stroke-width="1"/>
