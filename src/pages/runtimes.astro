}`,
    diff:
      "Same async/await as Tokio, but the primitives come from small crates: event_listener::Event replaces Notify, and you build the multi-thread Executor by hand instead of getting it from a macro.",
    source: `use event_listener::Event;
use std::sync::Arc;

// event_listener::Event is smol's stand-in for Tokio's Notify
async fn listen_loop(wakeup: Arc<Event>) {
    loop {
        smol::Timer::after(std::time::Duration::from_secs(1)).await;
        wakeup.notify(usize::MAX);      // wake all listeners
    }
}

async fn relay_loop(wakeup: Arc<Event>) {
    loop {
        wakeup.listen().await;          // register + wait for a signal
        println!("relaying outbox batch...");
    }
}

fn main() {
    let wakeup = Arc::new(Event::new());
    // no runtime macro: build a multi-thread executor by hand
    let ex = Arc::new(smol::Executor::new());
    smol::block_on(ex.run(async {
        ex.spawn(listen_loop(wakeup.clone())).detach();
        for _ in 0..4 {
            ex.spawn(relay_loop(wakeup.clone())).detach();
        }
        futures_lite::future::pending::<()>().await;
    }));
}`,
  },
  {
    runtime: "Rust / glommio",
    lang: "rust",
    accent: "#be185d",
    note: "Thread-per-core, io_uring-based. Each core runs its own executor with no cross-thread synchronisation. Best for storage-heavy workloads.",
    simpleDiff:
      "Thread-per-core: the executor is pinned to one CPU and spawn_local keeps tasks there. Because tasks never move, they need not be Send, so cheap Rc/RefCell work instead of Arc/Mutex.",
    simpleSource: `use glommio::LocalExecutorBuilder;

fn main() {
    // one executor pinned to the current core (built via the builder)
    let ex = LocalExecutorBuilder::default().make().unwrap();
    ex.run(async {
        let mut handles = Vec::new();
        for i in 0..4 {
            // spawn_local: tasks stay on this core (no Send bound)
            handles.push(glommio::spawn_local(async move { i * i }));
        }
        let mut results = Vec::new();
        for h in handles {
            results.push(h.await);
        }
        println!("{:?}", results); // [0, 1, 4, 9]
    });
}`,
    diff:
      "No cross-thread sync at all: Rc<RefCell<_>> replaces Arc<Notify>. There is no built-in Notify, so the workers poll a plain flag cooperatively. Runs on io_uring, Linux-only.",
    source: `use glommio::{LocalExecutorBuilder, Placement};
use std::{cell::RefCell, rc::Rc};

// single core => Rc/RefCell instead of Arc/Mutex; no Notify built in
async fn listen_loop(wakeup: Rc<RefCell<bool>>) {
    loop {
        glommio::timer::sleep(std::time::Duration::from_secs(1)).await;
        *wakeup.borrow_mut() = true;         // set a plain flag
    }
}

async fn relay_loop(wakeup: Rc<RefCell<bool>>) {
    loop {
        // no Notify: poll the flag cooperatively
        while !*wakeup.borrow() {
            glommio::timer::sleep(std::time::Duration::from_millis(10)).await;
        }
        *wakeup.borrow_mut() = false;
        println!("relaying outbox batch...");
    }
}

fn main() {
    LocalExecutorBuilder::new(Placement::Fixed(0))  // pin to core 0
        .spawn(|| async {
            let wakeup = Rc::new(RefCell::new(false));
            glommio::spawn_local(listen_loop(wakeup.clone())).detach();
            for _ in 0..4 {
                glommio::spawn_local(relay_loop(wakeup.clone())).detach();
            }
            futures_lite::future::pending::<()>().await;
        })
        .unwrap()
        .join()
        .unwrap();
}`,
  },
  {
    runtime: "Go (goroutines)",
    lang: "go",
    accent: "#00ADD8",
    note: "M:N scheduler built into the runtime. No async/await: goroutines block transparently. Channels and sync primitives for coordination.",
    simpleDiff:
      "No async or await keywords at all. go f() starts a goroutine; a WaitGroup joins them. Blocking calls yield the thread transparently.",
    simpleSource: `package main

import (
	"fmt"
	"sync"
)

func main() {
	results := make([]int, 4)
	var wg sync.WaitGroup
	for i := 0; i < 4; i++ {
		wg.Add(1)
		go func(i int) { // no async keyword, just "go"
			defer wg.Done()
			results[i] = i * i
		}(i)
	}
	wg.Wait()            // join all goroutines
	fmt.Println(results) // [0 1 4 9]
}`,
    diff:
      "The channel *is* the signal: there is no separate Event/Notify type. Workers range over the channel; a WaitGroup replaces JoinSet/gather. Everything is plain blocking code the scheduler makes concurrent.",
    source: `package main

import (
	"fmt"
	"sync"
	"time"
)

type OutboxRelayWorker struct {
	workerCount int
}

func (w *OutboxRelayWorker) listenLoop(wakeup chan struct{}) {
	for {
		time.Sleep(1 * time.Second)
		select {
		case wakeup <- struct{}{}: // non-blocking send
		default:                   // drop if no worker is ready
		}
	}
}

func (w *OutboxRelayWorker) relayLoop(wakeup chan struct{}, wg *sync.WaitGroup) {
	defer wg.Done()
	for range wakeup { // ranges until the channel closes
		fmt.Println("relaying outbox batch...")
	}
}

func (w *OutboxRelayWorker) Run() {
	wakeup := make(chan struct{}, 1) // the channel *is* the signal
	var wg sync.WaitGroup

	go w.listenLoop(wakeup) // no async keyword, just "go"

	for i := 0; i < w.workerCount; i++ {
		wg.Add(1)
		go w.relayLoop(wakeup, &wg)
	}
	wg.Wait()
}

func main() {
	(&OutboxRelayWorker{workerCount: 4}).Run()
}`,
  },
];

