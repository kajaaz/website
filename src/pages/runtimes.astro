                <text x="86" y="26" text-anchor="middle" font-size="7" fill="#6B7280">transpile</text>
                <line x1="58" y1="30" x2="114" y2="30" stroke={m.accent} stroke-width="1.2" marker-end="url(#rt-tr-arr)"/>
                <rect x="116" y="18" width="56" height="24" rx="4" fill={m.accent} fill-opacity="0.12" stroke={m.accent} stroke-width="1.2"/>
                <text x="144" y="33" text-anchor="middle" font-size="8.5" fill={m.accent} font-weight="600">JavaScript</text>
