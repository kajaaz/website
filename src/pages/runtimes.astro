// Pre-highlight all snippets and merge comparison properties at build time
const highlightedSnippets = await Promise.all(
  runtimeSnippets.map(async (s) => {
    const props: Record<string, string> = {};
    for (const row of runtimeComparison) {
      const val = row.values[s.runtime as keyof typeof row.values];
      if (val) props[row.property] = val;
    }
    return {
      runtime: s.runtime,
      accent: s.accent,
      note: s.note,
      simpleDiff: s.simpleDiff,
      simpleHtml: await highlightCode(s.lang, s.simpleSource),
      diff: s.diff,
      html: await highlightCode(s.lang, s.source),
      properties: props,
    };
  }),
);

// Sync vs async, focused on Rust
const syncVsAsync = [
  { property: "Concurrency unit", sync: "OS thread (1:1 with a kernel thread)", asyncv: "Future / task (M:N on a thread pool)" },
  { property: "Spawned with", sync: "std::thread::spawn", asyncv: "tokio::spawn / smol::spawn" },
  { property: "Cost per unit", sync: "~1–8 MB stack + kernel bookkeeping", asyncv: "~a few hundred bytes, no own stack" },
  { property: "Practical count", sync: "Thousands", asyncv: "Millions" },
  { property: "Scheduling", sync: "Pre-emptive, by the OS kernel", asyncv: "Cooperative, yields only at .await points" },
  { property: "Blocking a call", sync: "Fine, only that one thread waits", asyncv: "Dangerous: stalls the whole executor (use spawn_blocking)" },
  { property: "I/O", sync: "Blocking syscalls (read / write)", asyncv: "Non-blocking + epoll / kqueue / io_uring" },
  { property: "CPU-bound work", sync: "Ideal (threads, rayon)", asyncv: "Poor: offload to a thread pool" },
  { property: "Many connections", sync: "Limited by thread count", asyncv: "Excellent: the reason async exists" },
  { property: "Cancellation", sync: "Hard: no safe way to kill a thread", asyncv: "Easy: just drop the future" },
  { property: "Complexity", sync: "Simple, direct, no function colouring", asyncv: "async colouring, Send + 'static, Pin, lifetimes" },
  { property: "Ecosystem", sync: "std, rayon, crossbeam", asyncv: "tokio, async-std, smol, futures" },
];

const syncAsyncCode = {
  sync: `use std::thread;

fn main() {
    let mut handles = Vec::new();
    for i in 0..4 {
        // each worker gets its own OS thread (~MBs of stack)
        handles.push(thread::spawn(move || i * i));
    }
    // join blocks the main thread until each finishes
    let results: Vec<i32> = handles
        .into_iter()
        .map(|h| h.join().unwrap())
        .collect();
    println!("{:?}", results); // [0, 1, 4, 9]
}`,
  async: `#[tokio::main]                       // sets up the async runtime
async fn main() {
    let mut handles = Vec::new();
    for i in 0..4 {
        // each worker is a lightweight task (~hundreds of bytes)
        handles.push(tokio::spawn(async move { i * i }));
    }
    // .await yields instead of blocking the thread
    let mut results = Vec::new();
    for h in handles {
        results.push(h.await.unwrap());
    }
    println!("{:?}", results); // [0, 1, 4, 9]
}`,
};

const syncAsyncHtml = {
  sync: await highlightCode("rust", syncAsyncCode.sync),
  async: await highlightCode("rust", syncAsyncCode.async),
};

