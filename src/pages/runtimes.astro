        return 5; // resolves THIS Task, not Example()
    };

    Task<int> x = inner(); // a Task, but it is hot: already running (eager)
    return await x;        // await yields 5
}`,
  },
  {
    lang: "Go",
    hl: "go",
    accent: "#00ADD8",
    note: "No async keyword; a goroutine plus channel play the future's role.",
    abstraction: "goroutine (no async syntax)",
    laziness: "Eager: starts on go f()",
    builtin: "Yes: scheduler is part of the runtime",
    io: "netpoller does non-blocking I/O, M:N under the hood",
    syntax: "go f() (blocking-looking code)",
    code: `// no async/await: a goroutine + channel stand in for a future
func double(x int, out chan<- int) {
    out <- x * 2 // starts running immediately (eager)
}

func main() {
    out := make(chan int, 2)
    go double(10, out)
    go double(20, out)
    fmt.Println(<-out + <-out) // 60
}`,
    code2: `func example() int {
    ch := make(chan int, 1)
    go func() {
        ch <- 5
        return // returns from the goroutine, not example()
    }()

    // the channel receive is the "await": it produces 5
    return <-ch
}`,
  },
];

// Pre-highlight the per-language snippets and shape them for FutureCompare
const futureLangEntries = await Promise.all(
  asyncLangModels.map(async (e) => ({
    lang: e.lang,
    accent: e.accent,
    note: e.note,
    properties: {
      "Abstraction": e.abstraction,
      "Lazy or eager": e.laziness,
      "Runtime built in": e.builtin,
      "Scheduling / I-O": e.io,
      "Syntax": e.syntax,
    },
    html: await highlightCode(e.hl, e.code),
    structHtml: await highlightCode(e.hl, e.code2),
  })),
);

const executionModels = [
  {
    id: "native",
    name: "Native (AOT)",
    accent: "#16653a",
    desc: "Compiled ahead-of-time to machine code that the CPU runs directly. No layer in between: fastest, smallest, but tied to one platform.",
    langs: ["C", "C++", "Rust", "Go", "Zig", "Fortran", "Swift", "OCaml"],
  },
  {
    id: "jit",
    name: "JIT (Just-In-Time)",
    accent: "#4338CA",
    desc: "Runs from bytecode, then recompiles hot paths into optimised native code while the program is running. Slow to warm up, near-native once hot.",
    langs: ["Java (HotSpot)", "C# (.NET)", "JavaScript (V8)", "Julia", "LuaJIT", "PyPy"],
  },
  {
    id: "bytecode-vm",
    name: "Bytecode VM",
    accent: "#B45309",
    desc: "Compiled to portable bytecode that a virtual machine executes, providing GC and a sandbox. Write once, run anywhere the VM exists.",
    langs: ["Java (JVM)", "C# (CLR)", "Erlang (BEAM)", "Python (CPython)", "Ruby (YARV)"],
  },
  {
    id: "interpreter",
    name: "Interpreter",
    accent: "#be185d",
    desc: "Reads and executes the source statement by statement, no compile step. Instant startup and a live REPL, but slowest for heavy CPU work.",
    langs: ["Python", "Ruby", "PHP", "Perl", "sh / Bash", "R", "SQL"],
  },
  {
    id: "wasm",
    name: "WebAssembly",
    accent: "#7C3AED",
    desc: "Compiled to a portable binary that runs inside a sandbox (browser or Wasmtime). Near-native speed; I/O only through explicit host imports.",
    langs: ["Rust", "C", "C++", "Go", "Zig", "AssemblyScript"],
  },
  {
    id: "transpile",
    name: "Transpiler",
    accent: "#0891B2",
    desc: "Translated to another high-level language (usually JS or C) rather than machine code, then that language's toolchain takes over.",
    langs: ["TypeScript → JS", "Elm → JS", "PureScript → JS", "Cython → C"],
  },
];

const asyncEcosystems = [
  {
    lang: "Rust",
    accent: "#D97706",
    model: "Stackless coroutines via async/await. The compiler generates state machines; a user-chosen executor polls them.",
    runtimes: [
      { name: "Tokio", role: "General-purpose multi-threaded, work-stealing scheduler. The default choice for servers." },
      { name: "smol", role: "Lightweight, single-dependency executor. Good for CLIs and small services." },
      { name: "embassy", role: "Async executor for embedded / bare-metal (no_std). Runs on microcontrollers." },
      { name: "glommio", role: "Thread-per-core, io_uring-based. Optimised for high-throughput storage and networking." },
      { name: "compio", role: "Completion-based (io_uring / IOCP). Cross-platform alternative to glommio." },
    ],
  },
  {
    lang: "JavaScript / TypeScript",
    accent: "#F59E0B",
    model: "Single-threaded event loop with async/await. I/O callbacks are queued; the microtask queue runs Promises.",
    runtimes: [
      { name: "V8 (Chrome, Node.js, Deno, Bun)", role: "JIT-compiled engine with libuv (Node) or native event loop (Deno/Bun)." },
      { name: "SpiderMonkey (Firefox)", role: "Mozilla's engine with baseline + IonMonkey JIT tiers." },
      { name: "JavaScriptCore (Safari, Bun)", role: "Apple's engine, also used by Bun for fast startup." },
    ],
  },
  {
    lang: "Python",
    accent: "#3B82F6",
    model: "asyncio event loop with async/await. The GIL limits true parallelism in CPython; use multiprocessing or a native extension for CPU work.",
    runtimes: [
      { name: "asyncio (stdlib)", role: "Default event loop. selector-based on Unix, IOCP on Windows." },
      { name: "uvloop", role: "Drop-in replacement built on libuv. 2-4x faster than the default loop." },
      { name: "Trio", role: "Structured-concurrency-first library: nurseries enforce task lifetime rules." },
      { name: "AnyIO", role: "Compatibility layer that works on top of asyncio or Trio." },
    ],
  },
  {
    lang: "Go",
    accent: "#00ADD8",
    model: "M:N scheduling with goroutines (lightweight green threads) and channels. No async/await syntax needed: every function is implicitly non-blocking.",
    runtimes: [
      { name: "Go runtime", role: "Built-in scheduler multiplexes goroutines across OS threads. netpoller handles I/O." },
    ],
  },
  {
    lang: "Java / Kotlin (JVM)",
    accent: "#DC2626",
    model: "Platform threads mapped 1:1 to OS threads, plus (since Java 21) virtual threads via Project Loom for M:N scheduling.",
    runtimes: [
      { name: "Platform threads", role: "Classic OS threads, heavyweight (~1MB stack each)." },
      { name: "Virtual threads (Loom)", role: "JVM-managed lightweight threads, millions per process. Blocking calls auto-yield." },
      { name: "Kotlin coroutines", role: "Structured concurrency with suspend/resume, dispatched to thread pools." },
    ],
  },
  {
    lang: "C#",
    accent: "#512BD4",
    model: "Task-based asynchronous pattern (TAP) with async/await. The runtime schedules continuations on the thread pool or a synchronisation context.",
    runtimes: [
      { name: ".NET ThreadPool + Task scheduler", role: "Work-stealing thread pool. Task.Run dispatches CPU work; I/O operations use IOCP." },
    ],
  },
  {
    lang: "Erlang / Elixir",
    accent: "#A855F7",
    model: "Actor model on the BEAM VM: each process is an isolated lightweight unit with its own heap, communicating solely via message passing.",
    runtimes: [
      { name: "BEAM VM", role: "Preemptive scheduler with per-process reduction budgets. Millions of processes, no shared state." },
      { name: "OTP", role: "Framework of supervisors, gen_servers and behaviours. Fault tolerance by design." },
    ],
  },
];

const comparisonTable = [
  { model: "Native (AOT)",      startup: "Fast",        peak: "Highest",    memory: "Lowest",  portability: "Recompile per target", gc: "Manual / ownership" },
  { model: "JIT",               startup: "Slow (warm-up)", peak: "Near-native", memory: "High", portability: "VM per platform",      gc: "GC (tracing)" },
  { model: "Bytecode VM",       startup: "Medium",      peak: "Good",       memory: "Medium",  portability: "VM per platform",       gc: "GC (tracing)" },
  { model: "Interpreter",       startup: "Instant",     peak: "Lowest",     memory: "Medium",  portability: "Interpreter per platform", gc: "GC (ref-counting / tracing)" },
  { model: "WebAssembly",       startup: "Fast",        peak: "Near-native", memory: "Low",    portability: "Universal (sandboxed)",    gc: "Depends on source lang" },
  { model: "Transpiler",        startup: "Depends on target", peak: "Depends on target", memory: "Depends on target", portability: "Same as target", gc: "Same as target" },
];
