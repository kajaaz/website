                <rect x="74" y="6" width="160" height="52" rx="6" fill={m.accent} fill-opacity="0.05" stroke={m.accent} stroke-width="1.4" stroke-dasharray="4 3"/>
                <text x="154" y="17" text-anchor="middle" font-size="7.5" fill={m.accent} font-weight="700">sandbox</text>
                <rect x="86" y="24" width="48" height="22" rx="3" fill={m.accent} fill-opacity="0.15" stroke={m.accent} stroke-width="1"/>
                <text x="110" y="38" text-anchor="middle" font-size="8" fill={m.accent} font-weight="600" font-family="monospace">.wasm</text>
                <line x1="134" y1="35" x2="156" y2="35" stroke={m.accent} stroke-width="1.2" marker-end="url(#rt-wasm-arr)"/>
                <rect x="158" y="24" width="66" height="22" rx="3" fill="#10B981" fill-opacity="0.12" stroke="#10B981" stroke-width="1"/>
                <text x="191" y="38" text-anchor="middle" font-size="7.5" fill="#047857" font-weight="600">host runtime</text>
                <defs><marker id="rt-wasm-arr" markerWidth="7" markerHeight="5" refX="6" refY="2.5" orient="auto"><path d="M0,0 L7,2.5 L0,5" fill={m.accent}/></marker></defs>
