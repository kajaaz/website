                <line x1="122" y1="31" x2="150" y2="31" stroke={m.accent} stroke-width="1.2" marker-end="url(#rt-int-arr)"/>
                <rect x="152" y="18" width="86" height="26" rx="4" fill={m.accent} fill-opacity="0.12" stroke={m.accent} stroke-width="1.2"/>
                <text x="195" y="30" text-anchor="middle" font-size="8" fill={m.accent} font-weight="600">execute now</text>
                <text x="195" y="39" text-anchor="middle" font-size="6.5" fill="#6B7280">line by line</text>
