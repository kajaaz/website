  { property: "Spawned with", sync: "std::thread::spawn", asyncv: "tokio::spawn / smol::spawn" },
  { property: "Threads used", sync: "One OS thread per task", asyncv: "1..N, optional: a single thread is enough" },
  { property: "Cost per unit", sync: "~1–8 MB stack + kernel bookkeeping", asyncv: "~a few hundred bytes, no own stack" },
  { property: "Practical count", sync: "Thousands", asyncv: "Millions" },
  { property: "Scheduling", sync: "Pre-emptive, by the OS kernel", asyncv: "Cooperative: the executor polls, tasks yield at .await" },
  { property: "Blocking a call", sync: "Fine, only that one thread waits", asyncv: "Dangerous: stalls the whole executor (use spawn_blocking)" },
  { property: "I/O", sync: "Blocking syscalls (read / write)", asyncv: "Non-blocking + epoll / kqueue / io_uring" },
  { property: "CPU-bound work", sync: "Ideal (threads, rayon)", asyncv: "Poor: cooperative tasks starve; offload with spawn_blocking or rayon" },
  { property: "Many connections", sync: "Limited by thread count", asyncv: "Excellent: the reason async exists" },
  { property: "Cancellation", sync: "Hard: no safe way to kill a thread", asyncv: "Easy: just drop the future" },
  { property: "Complexity", sync: "Simple, direct, no function colouring", asyncv: "async colouring, Send + 'static, Pin, lifetimes" },
  { property: "Ecosystem", sync: "std, rayon, crossbeam", asyncv: "tokio, async-std, smol, futures" },
