                <rect x="116" y="18" width="56" height="24" rx="4" fill={m.accent} fill-opacity="0.12" stroke={m.accent} stroke-width="1.2"/>
                <text x="144" y="33" text-anchor="middle" font-size="8.5" fill={m.accent} font-weight="600">JavaScript</text>
                <line x1="172" y1="30" x2="196" y2="30" stroke={m.accent} stroke-width="1.2" marker-end="url(#rt-tr-arr)"/>
                <rect x="198" y="18" width="40" height="24" rx="4" fill="#10B981" fill-opacity="0.12" stroke="#10B981" stroke-width="1.2"/>
                <text x="218" y="30" text-anchor="middle" font-size="7.5" fill="#047857" font-weight="600">JS</text>
                <text x="218" y="38" text-anchor="middle" font-size="6" fill="#6B7280">runtime</text>
                <text x="120" y="55" text-anchor="middle" font-size="7" fill="#9CA3AF">reuses the target's toolchain</text>
                <defs><marker id="rt-tr-arr" markerWidth="7" markerHeight="5" refX="6" refY="2.5" orient="auto"><path d="M0,0 L7,2.5 L0,5" fill={m.accent}/></marker></defs>
              </svg>
