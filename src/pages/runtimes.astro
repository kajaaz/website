// A Future is just a value with a poll method. async fn compiles to one.
const futureSource = `use std::future::Future;
use std::pin::Pin;
use std::task::{Context, Poll};
use std::time::Instant;

// A hand-written future: an async fn compiles to something like this.
struct Delay { deadline: Instant }

impl Future for Delay {
    type Output = ();

    // The executor calls poll(). We either finish or ask to be polled later.
    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<()> {
        if Instant::now() >= self.deadline {
            Poll::Ready(())                 // done: hand back the value
        } else {
            // Not ready. Hand the executor a Waker so it can re-poll us
            // once the timer fires, instead of busy-looping.
            register_timer(self.deadline, cx.waker().clone());
            Poll::Pending
        }
    }
}`;
const futureHtml = await highlightCode("rust", futureSource);

// What "async fn" desugars into: a resumable state machine.
const stateMachineSource = `// You write this:
async fn handle(mut sock: TcpStream) -> usize {
    let n = sock.read(&mut buf).await;   // pause point #1
    store(&buf[..n]).await;              // pause point #2
    n                                    // final value
}

// The compiler rewrites it into roughly this state machine.
// Each .await becomes a state the future can be "parked" in.
enum Handle {
    Start   { sock: TcpStream },              // not polled yet
    Reading { fut: ReadFuture },              // parked at .await #1
    Storing { fut: StoreFuture, n: usize },   // parked at .await #2
    Done,
}

// poll() looks at the current state, tries to drive the inner
// future, and either advances to the next state, returns
// Poll::Pending (saving where it stopped), or Poll::Ready(n).`;
const stateMachineHtml = await highlightCode("rust", stateMachineSource);

// Control flow: `return` inside an async block resolves the block's Future,
// not the enclosing function. Proof that an async block is a value.
const returnSyncSource = `// A plain block: \`return\` exits the whole function.
fn example() -> i32 {
    let x = {
        return 5; // returns from example() immediately
    };
    // unreachable: the block diverges, so x has the never type \`!\`
}`;
const returnAsyncSource = `// An async block: \`return\` resolves the block's Future.
async fn example() -> i32 {
    let x = async {
        return 5; // sets this Future's output to 5, does NOT exit example()
    };

    // x is a Future<Output = i32>. It has run no code yet (lazy).
    x.await // driving it here is what finally produces 5
}`;
const returnSyncHtml = await highlightCode("rust", returnSyncSource);
const returnAsyncHtml = await highlightCode("rust", returnAsyncSource);

