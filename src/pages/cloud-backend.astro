  ["Ansible", "ansible.svg", "https://docs.ansible.com/ansible/latest/collections/amazon/aws/aws_ec2_inventory.html", "Configures the VMs that are not in Kubernetes.", "VMs, Vagrant"],
  ["Argo CD", "argocd.svg", "https://argo-cd.readthedocs.io/en/stable/user-guide/helm/", "CD: keeps every cluster equal to the gitops repo.", "Azure Repos, JFrog, Kubernetes"],
  ["Atlantis", "atlantis.png", "https://www.runatlantis.io/docs/autoplanning.html", "Runs Terraform from pull requests, so every infrastructure change is reviewed with its plan.", "Azure Repos, Terraform"],
  ["AWS", "amazonwebservices.svg", "https://docs.aws.amazon.com/eks/latest/userguide/what-is-eks.html", "Runs one copy of the platform (EKS, ECR, EC2, VPC, IAM) and the website's own EKS cluster.", "Terraform, Argo CD, Wiz"],
  ["Azure", "azure.svg", "https://learn.microsoft.com/en-us/azure/aks/what-is-aks", "Runs the other copy: AKS, ACR, Azure VMs, VNet and Entra ID.", "Terraform, Argo CD, Wiz"],
  ["Azure DevOps", "azuredevops.svg", "https://learn.microsoft.com/en-us/azure/devops/repos/git/branch-policies", "Hosts the three Git repos behind branch policies and push protection, and Boards for work items.", "Jenkins, Atlantis, Argo CD"],
  ["Cloudflare", "cloudflare.svg", "https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/", "DNS, CDN, WAF and DDoS protection in front of the website; Zero Trust in front of the internal tools: Access, WARP and cloudflared tunnels.", "visitors, Envoy, Entra ID, Datadog"],
  ["Conftest", "opa.svg", "https://www.runatlantis.io/docs/policy-checking.html", "Checks every Terraform plan against Rego policies before Atlantis may apply it.", "Atlantis"],
  ["Cosign", "cosign.svg", "https://docs.sigstore.dev/cosign/key_management/overview/", "Signs each image and attests its SBOM with a key kept in AWS KMS or Key Vault.", "Jenkins, ECR, ACR, Kyverno"],
  ["Datadog", "datadog.svg", "https://docs.datadoghq.com/opentelemetry/", "Dashboards, APM and monitors for the apps, Argo CD and JFrog; Cloudflare's logs too.", "the Collector gateway, Cloudflare, on-call"],
  ["Docker", "docker.svg", "https://docs.docker.com/get-started/docker-overview/", "Builds and runs images on the laptop.", "nothing in production"],
  ["EDR", "edr.svg", "https://csrc.nist.gov/glossary/term/endpoint_detection_and_response", "Sensors on laptops, VMs and nodes that detect and contain attacks on the machine.", "EDR console, the SIEM"],
  ["Entra ID", "entra.svg", "https://learn.microsoft.com/en-us/entra/fundamentals/whatis", "The one login for people: MFA and Conditional Access, single sign-on into the clouds and tools, groups mapped to roles.", "AWS, AKS, Cloudflare Access, the web tools"],
  ["Envoy", "envoy.svg", "https://gateway.envoyproxy.io/docs/", "Envoy Gateway is the website cluster's ingress; it sends access logs and traces in OTLP.", "Cloudflare, the Collector"],
  ["External Secrets", "externalsecrets.svg", "https://external-secrets.io/latest/provider/aws-secrets-manager/", "Copies secrets from the cloud stores into Kubernetes Secrets, using the pod identity of its cloud.", "Secrets Manager, Key Vault"],
  ["Helm", "helm.svg", "https://helm.sh/docs/", "Packages each app and each add-on as a chart, with values per environment.", "Argo CD, JFrog"],
  ["Jenkins", "jenkins.svg", "https://www.jenkins.io/doc/book/pipeline/", "CI: tests, builds, scans, signs and pushes images, publishes charts, bumps the tag in the gitops repo.", "Azure DevOps, Podman, JFrog"],
  ["JFrog", "jfrog.svg", "https://jfrog.com/help/r/jfrog-artifactory-documentation/helm-chart-repositories", "Artifactory hosts the Helm charts and proxies npm, PyPI and Maven; Curation blocks risky packages, Xray scans what is stored.", "Jenkins, Argo CD, Datadog"],
  ["Kubernetes", "kubernetes.svg", "https://kubernetes.io/docs/concepts/overview/", "Runs the apps, the website and the add-ons, on EKS and AKS.", "Argo CD, the registries"],
  ["Kyverno", "kyverno.svg", "https://kyverno.io/docs/policy-types/cluster-policy/verify-images/sigstore/", "Admission policies in every cluster: only signed images from our registries may run.", "Kubernetes, Cosign"],
  ["OpenTelemetry", "opentelemetry.svg", "https://opentelemetry.io/docs/collector/deployment/gateway/", "One protocol, OTLP; a Collector agent per cluster and a gateway per cloud that routes traces, metrics and logs.", "apps, Envoy, Datadog, the SIEM"],
  ["Podman", "podman.svg", "https://docs.podman.io/en/latest/", "Builds images on the Jenkins agents, rootless and without a daemon.", "Jenkins, ECR, ACR"],
  ["Prometheus", "prometheus.svg", "https://prometheus.io/docs/introduction/overview/", "Stores cluster metrics and evaluates alert rules; Alertmanager pages on-call.", "the Collector"],
  ["Secret stores", "keyvault.svg", "https://learn.microsoft.com/en-us/azure/key-vault/general/overview", "AWS Secrets Manager and Azure Key Vault hold passwords, API keys and the signing keys.", "External Secrets, Cosign"],
  ["Session Manager, Bastion", "amazonwebservices.svg", "https://docs.aws.amazon.com/systems-manager/latest/userguide/session-manager.html", "Shells on the VMs without an open SSH port: SSM Session Manager on AWS, Azure Bastion on Azure; every session is logged.", "VMs, Entra ID, the SIEM"],
  ["SIEM", "siem.svg", "https://csrc.nist.gov/glossary/term/security_information_and_event_management", "Collects security logs, cloud audit logs, EDR detections and Wiz findings, and alerts the security team; candidates are compared below.", "the Collector gateway, EDR, Wiz"],
  ["syslog", "syslog.svg", "https://datatracker.ietf.org/doc/html/rfc5424", "The standard log protocol of VMs and network appliances.", "the Collector"],
  ["Terraform", "terraform.svg", "https://developer.hashicorp.com/terraform/language/backend/s3", "Declares the resources in both clouds; keeps state in S3 or Blob Storage.", "AWS, Azure"],
  ["Trivy", "trivy.svg", "https://trivy.dev/latest/docs/supply-chain/sbom/", "Scans each image for known vulnerabilities in Jenkins and writes its SBOM.", "Jenkins, Cosign"],
  ["Vagrant", "vagrant.svg", "https://developer.hashicorp.com/vagrant/docs/provisioning/ansible", "Local VMs to test Ansible roles before they reach the cloud.", "Ansible"],
  ["Wiz", "wiz.png", "https://www.wiz.io/academy/agentless-scanning", "Agentless cloud security: scans both clouds for misconfigurations and vulnerabilities.", "AWS, Azure, the SIEM"],
];
---

<BaseLayout title="Cloud Backend" toc>
  <p class="mono-eyebrow mb-1"><span class="text-accent-blue">$</span> kubectl get all -A</p>
  <h1 class="glitch is-intro mb-4 text-3xl font-bold tracking-tight text-brand-text" data-text="Cloud Backend">Cloud Backend</h1>

  <!-- What is it? -->
  <div class="mb-10 rounded-xl bg-accent-green/15 p-5 sm:p-6">
    <h2 class="mb-1 text-sm font-bold text-brand-text">What is it?</h2>
    <p class="text-sm leading-relaxed text-brand-body">
      One example backend where common cloud, DevOps and security tools each have a single job: code reaches two clouds
      through Git only, infrastructure changes go through reviewed pull requests, the website sits behind Cloudflare,
      each signal goes only to the tools that need it, people sign in once and reach internal tools without a VPN, no
      cloud access key lives longer than a few hours, and clusters run only images that CI signed.
    </p>
  </div>

  <!-- ====== OVERVIEW ====== -->
  <section class="mb-14">
    <p class="mono-eyebrow mb-2">// git push --&gt; production</p>
    <h2 class="glitch mb-4 text-xl font-semibold text-brand-text" data-text="The architecture">The architecture</h2>
    <p class="mb-6 text-brand-body">
      Five flows share the platform: shipping an app, changing the infrastructure, serving the website, collecting logs
      and detecting threats, and operating it. The diagrams after this one zoom in on traffic, logs, identity and
      secrets, and the supply chain; the page ends with the Kubernetes vocabulary.
    </p>

    <figure class="mb-8 overflow-x-auto rounded-xl border border-brand-border bg-white p-4 sm:p-6">
      <svg viewBox="0 0 1000 1375" class="cloud-svg mx-auto block h-auto w-full max-w-[980px] min-w-[860px]" role="img" aria-labelledby="ov-title ov-desc">
        <title id="ov-title">Overview of the example cloud backend across AWS and Azure</title>
        <desc id="ov-desc">At the top, an engineer's laptop with Docker, Vagrant and an EDR agent, and Azure DevOps with the infra, app and gitops repos and Boards. Below, Ansible, Atlantis with Terraform, Jenkins with Podman, JFrog Artifactory and Argo CD with Helm, and Entra ID for every login. Visitors reach Cloudflare, which forwards to Envoy Gateway in the website's EKS cluster. In AWS and Azure: VMs, the ECR and ACR registries, the secret stores and signing keys, the app clusters, the website cluster, and add-ons in every cluster: Prometheus, the Datadog Agent, the OpenTelemetry Collector, the EDR sensor, cloudflared, Kyverno and the External Secrets Operator. The Collectors and the VMs' syslog feed a Collector gateway in each cloud, which sends everything to Datadog and only security logs to the SIEM. Wiz scans both clouds, the EDR console receives sensor telemetry, and both report to the SIEM. Datadog pages the on-call engineer, who reaches internal tools through Cloudflare Zero Trust and production with short-lived cloud IAM credentials.</desc>
        <defs>
          <marker id="ov" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1.5 1L8.5 5L1.5 9" fill="none" stroke="context-stroke" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </marker>
        </defs>

        <!-- frames -->
        <rect class="os-world" x="20" y="40" width="260" height="160" rx="12"/>
        <text class="frame-title" x="32" y="57">Engineer's laptop</text>
        <g>
          <rect x="90" y="161" width="124" height="22" rx="11" fill="#ffffff" stroke="#334155" stroke-width="1.2"/>
          <image href="/logos/edr.svg" x="104" y="165" width="14" height="14"/>
          <text x="122" y="172" dominant-baseline="central" class="pill" fill="#334155">EDR agent</text>
        </g>
        <rect class="os-world" x="340" y="40" width="640" height="120" rx="12"/>
        <image href="/logos/azuredevops.svg" x="353" y="48" width="18" height="18"/>
        <image href="/logos/github.svg" x="375" y="48" width="18" height="18"/>
        <text class="frame-title" x="399" y="57">Azure DevOps: Repos and Boards / GitHub</text>
        <rect class="os-world" x="20" y="560" width="960" height="480" rx="12"/>
        <image href="/logos/amazonwebservices.svg" x="34" y="571" width="30" height="22"/>
        <image href="/logos/azure.svg" x="70" y="573" width="18" height="18"/>
        <text class="frame-title" x="96" y="582">AWS and Azure</text>
        <rect x="280" y="700" width="320" height="150" rx="12" fill="#f7fbf2" stroke="#3b6d11" stroke-width="1.2"/>
        <image href="/logos/kubernetes.svg" x="294" y="711" width="18" height="18"/>
        <text class="frame-title" x="318" y="720" style="fill:#27500a">EKS / AKS: apps</text>
        <rect x="620" y="700" width="350" height="150" rx="12" fill="#f7fbf2" stroke="#3b6d11" stroke-width="1.2"/>
        <image href="/logos/kubernetes.svg" x="634" y="711" width="18" height="18"/>
        <text class="frame-title" x="658" y="720" style="fill:#27500a">EKS: website (AWS)</text>
        <rect x="280" y="865" width="690" height="70" rx="10" fill="#ffffff" stroke="#94a3b8" stroke-width="1" stroke-dasharray="6 4"/>
        <text class="frame-title" x="292" y="900">In every cluster:</text>
        {addons.map(([label, logo, x, y]) => <CloudPill x={x} y={y} label={label} logo={logo} w={Math.max(110, Math.round(32 + label.length * 6))} />)}

        {ovBoxes.map((b) => <CloudBox {...b} />)}
        {ovArrows.map((a) => <CloudArrow {...a} marker="ov" />)}

        <!-- legend -->
        {ovLegend.map(([color, label, dashed], i) => (
          <g>
            <line x1={ovLegendX[i]} y1="1360" x2={ovLegendX[i] + 34} y2="1360" stroke={color} stroke-width="2" stroke-dasharray={dashed ? "5 3" : undefined} marker-end="url(#ov)"/>
            <text class="ts" x={ovLegendX[i] + 44} y="1360" dominant-baseline="central" fill="#475569" style="font-size:11px">{label}</text>
          </g>
        ))}
      </svg>
      <figcaption class="mt-3 text-sm text-brand-muted">
        The cloud box is drawn once: AWS and Azure each run the same pieces, named AWS / Azure; the website cluster lives
        in AWS only. Argo CD, Atlantis and Jenkins are drawn apart from the clusters but often run
        inside one.
      </figcaption>
    </figure>

    {stepGroups.map((g) => (
      <>
        <h3 class="mb-4 mt-8 text-lg font-semibold text-brand-text">{g.title}</h3>
        <ol class="space-y-3">
          {g.steps.map((s) => (
            <li class="flex gap-3">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full font-mono text-xs font-semibold text-white" style={`background:${s.color}`}>{s.n}</span>
              <p class="leading-relaxed text-brand-body"><strong class="text-brand-text">{s.title}.</strong> {s.body}</p>
            </li>
          ))}
        </ol>
      </>
    ))}
  </section>

  <!-- ====== TRAFFIC AND ACCESS ====== -->
  <section class="mb-14">
    <p class="mono-eyebrow mb-2">// who gets in, and how</p>
    <h2 class="glitch mb-4 text-xl font-semibold text-brand-text" data-text="Traffic and access">Traffic and access</h2>
    <p class="mb-6 text-brand-body">
      Three doors, one per audience. Visitors only ever reach Cloudflare; engineers reach internal tools through
      Cloudflare Access and production over WARP with cloud IAM credentials, so nothing else listens on the internet.
    </p>

    <figure class="mb-8 overflow-x-auto rounded-xl border border-brand-border bg-white p-4 sm:p-6">
      <svg viewBox="0 0 1000 380" class="cloud-svg mx-auto block h-auto w-full max-w-[980px] min-w-[860px]" role="img" aria-labelledby="ta-title ta-desc">
        <title id="ta-title">Three ways in: the public website, internal tools and production</title>
        <desc id="ta-desc">Public: visitors reach Cloudflare, which forwards through an AWS network load balancer to Envoy Gateway, which routes to the website pods. Internal tools: an engineer's browser signs in to Cloudflare Access with Entra ID, which reaches the internal UIs of Jenkins, Argo CD and Atlantis through outbound cloudflared tunnels. Production: the WARP client reaches the private cluster endpoints through the same tunnels, cloud IAM issues short-lived kubectl tokens through EKS access entries and AKS Entra ID, and shells on VMs go through SSM Session Manager and Azure Bastion.</desc>
        <defs>
          <marker id="ta" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1.5 1L8.5 5L1.5 9" fill="none" stroke="context-stroke" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </marker>
        </defs>
        {taLanes.map((lane) => (
          <g>
            <text class="th" x="16" y={lane.y + 32} dominant-baseline="central" fill="#1e293b">{lane.name}</text>
            <text class="ts" x="16" y={lane.y + 50} dominant-baseline="central" fill="#64748b">{lane.sub}</text>
            {lane.boxes.map((b, i) => <CloudBox {...b} x={taX(i)} y={lane.y} w={190} h={80} />)}
            {lane.boxes.slice(1).map((_, i) => (
              <CloudArrow d={`M${taX(i) + 191} ${lane.y + 40} L${taX(i + 1) - 2} ${lane.y + 40}`} color={lane.color} marker="ta" />
            ))}
          </g>
        ))}
      </svg>
      <figcaption class="mt-3 text-sm text-brand-muted">
        Sources:{" "}
        <a href="https://developers.cloudflare.com/ssl/origin-configuration/authenticated-origin-pull/" target="_blank" rel="noopener noreferrer" class={link}>authenticated origin pulls</a>,{" "}
        <a href="https://docs.aws.amazon.com/elasticloadbalancing/latest/network/introduction.html" target="_blank" rel="noopener noreferrer" class={link}>AWS NLB</a>,{" "}
        <a href="https://gateway.envoyproxy.io/docs/" target="_blank" rel="noopener noreferrer" class={link}>Envoy Gateway</a>,{" "}
        <a href="https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/" target="_blank" rel="noopener noreferrer" class={link}>Cloudflare Tunnel</a>,{" "}
        <a href="https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/private-net/cloudflared/" target="_blank" rel="noopener noreferrer" class={link}>WARP to private networks</a>,{" "}
        <a href="https://docs.aws.amazon.com/eks/latest/userguide/access-entries.html" target="_blank" rel="noopener noreferrer" class={link}>EKS access entries</a>,{" "}
        <a href="https://docs.aws.amazon.com/eks/latest/userguide/cluster-endpoint.html" target="_blank" rel="noopener noreferrer" class={link}>EKS private endpoint</a>,{" "}
        <a href="https://learn.microsoft.com/en-us/azure/aks/enable-authentication-microsoft-entra-id" target="_blank" rel="noopener noreferrer" class={link}>AKS with Entra ID</a>,{" "}
        <a href="https://azure.github.io/kubelogin/" target="_blank" rel="noopener noreferrer" class={link}>kubelogin</a>,{" "}
        <a href="https://docs.aws.amazon.com/systems-manager/latest/userguide/session-manager.html" target="_blank" rel="noopener noreferrer" class={link}>SSM Session Manager</a>,{" "}
        <a href="https://learn.microsoft.com/en-us/azure/bastion/bastion-overview" target="_blank" rel="noopener noreferrer" class={link}>Azure Bastion</a>.
      </figcaption>
    </figure>
  </section>

  <!-- ====== LOGS ====== -->
  <section class="mb-14">
    <p class="mono-eyebrow mb-2">// route by signal</p>
    <h2 class="glitch mb-4 text-xl font-semibold text-brand-text" data-text="Logs, metrics and security">Logs, metrics and security</h2>
    <p class="mb-6 text-brand-body">
      An OpenTelemetry Collector agent in each cluster forwards everything to a gateway in its cloud, and the gateway
      routes each signal: all of it to Datadog, and only security events to the SIEM, so the tool that costs most per
      gigabyte sees the least data. Cloud audit logs and security findings reach the SIEM directly.
    </p>

    <figure class="mb-8 overflow-x-auto rounded-xl border border-brand-border bg-white p-4 sm:p-6">
      <svg viewBox="0 0 1000 560" class="cloud-svg mx-auto block h-auto w-full max-w-[980px] min-w-[860px]" role="img" aria-labelledby="lg-title lg-desc">
        <title id="lg-title">Where logs, metrics and security findings go</title>
        <desc id="lg-desc">Four columns: sources, collect, store and use. Argo CD and JFrog report to Datadog through its integrations, and Cloudflare pushes its logs there with Logpush. Apps and Envoy send OTLP, and VMs send syslog, to the OpenTelemetry Collectors, which keep metrics in Prometheus, send logs, metrics and traces to Datadog, and only security logs to the SIEM. The SIEM reads CloudTrail and the Azure Activity Log through its cloud connectors. EDR sensors on laptops, VMs and nodes report to the EDR console, and Wiz scans the cloud accounts; both send their findings to the SIEM.</desc>
        <defs>
          <marker id="lg" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1.5 1L8.5 5L1.5 9" fill="none" stroke="context-stroke" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </marker>
        </defs>
        <text class="divider-label" x="120" y="28" text-anchor="middle">SOURCES</text>
        <text class="divider-label" x="350" y="28" text-anchor="middle">COLLECT</text>
        <text class="divider-label" x="560" y="28" text-anchor="middle">STORE</text>
        <text class="divider-label" x="835" y="28" text-anchor="middle">USE</text>

        {lgBoxes.map((b) => <CloudBox {...b} />)}
        {lgArrows.map((a) => <CloudArrow {...a} marker="lg" />)}

        <line x1="20" y1="540" x2="54" y2="540" stroke={flow.logs} stroke-width="2" marker-end="url(#lg)"/>
        <text class="ts" x="64" y="540" dominant-baseline="central" fill="#475569" style="font-size:11px">logs</text>
        <line x1="160" y1="540" x2="194" y2="540" stroke={flow.metrics} stroke-width="2" marker-end="url(#lg)"/>
        <text class="ts" x="204" y="540" dominant-baseline="central" fill="#475569" style="font-size:11px">metrics and traces</text>
        <line x1="360" y1="540" x2="394" y2="540" stroke={flow.security} stroke-width="2" marker-end="url(#lg)"/>
        <text class="ts" x="404" y="540" dominant-baseline="central" fill="#475569" style="font-size:11px">security events and findings</text>
      </svg>
      <figcaption class="mt-3 text-sm text-brand-muted">
        Azure runs the same Collectors and its own gateway. Sources:{" "}
        <a href="https://opentelemetry.io/docs/specs/otlp/" target="_blank" rel="noopener noreferrer" class={link}>OTLP</a>,{" "}
        <a href="https://opentelemetry.io/docs/collector/deployment/gateway/" target="_blank" rel="noopener noreferrer" class={link}>gateway deployment</a>,{" "}
        <a href="https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/connector/routingconnector" target="_blank" rel="noopener noreferrer" class={link}>routing connector</a>,{" "}
        <a href="https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/filterprocessor" target="_blank" rel="noopener noreferrer" class={link}>filter processor</a>,{" "}
        <a href="https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/receiver/syslogreceiver" target="_blank" rel="noopener noreferrer" class={link}>syslog receiver</a>,{" "}
        <a href="https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/exporter/datadogexporter" target="_blank" rel="noopener noreferrer" class={link}>Datadog exporter</a>,{" "}
        <a href="https://www.envoyproxy.io/docs/envoy/latest/api-v3/config/trace/v3/opentelemetry.proto" target="_blank" rel="noopener noreferrer" class={link}>Envoy OpenTelemetry tracer</a>,{" "}
        <a href="https://developers.cloudflare.com/logs/logpush/logpush-job/enable-destinations/datadog/" target="_blank" rel="noopener noreferrer" class={link}>Logpush to Datadog</a>,{" "}
        <a href="https://docs.aws.amazon.com/awscloudtrail/latest/userguide/cloudtrail-user-guide.html" target="_blank" rel="noopener noreferrer" class={link}>CloudTrail</a>,{" "}
        <a href="https://docs.aws.amazon.com/eks/latest/userguide/control-plane-logs.html" target="_blank" rel="noopener noreferrer" class={link}>EKS control plane logs</a>,{" "}
        <a href="https://docs.datadoghq.com/integrations/argocd/" target="_blank" rel="noopener noreferrer" class={link}>Datadog for Argo CD</a>,{" "}
        <a href="https://docs.datadoghq.com/integrations/jfrog-platform-cloud/" target="_blank" rel="noopener noreferrer" class={link}>Datadog for JFrog Cloud</a>,{" "}
        <a href="https://www.wiz.io/academy/agentless-scanning" target="_blank" rel="noopener noreferrer" class={link}>agentless scanning</a>.
      </figcaption>
    </figure>
  </section>

  <!-- ====== IDENTITY AND SECRETS ====== -->
  <section class="mb-14">
    <p class="mono-eyebrow mb-2">// no long-lived keys</p>
    <h2 class="glitch mb-4 text-xl font-semibold text-brand-text" data-text="Identity and secrets">Identity and secrets</h2>
    <p class="mb-6 text-brand-body">
      People sign in once, through Entra ID, and machines never use a stored cloud key: every credential is issued on demand
      and expires within hours, so a copied file or a leaked log line stops working by itself. Leaving someone's Entra
      group removes their access everywhere within hours.
    </p>

    <figure class="mb-8 overflow-x-auto rounded-xl border border-brand-border bg-white p-4 sm:p-6">
      <svg viewBox="0 0 1000 420" class="cloud-svg mx-auto block h-auto w-full max-w-[980px] min-w-[860px]" role="img" aria-labelledby="id-title id-desc">
        <title id="id-title">How people, pods and pipelines get credentials</title>
