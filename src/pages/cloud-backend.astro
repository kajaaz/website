const stepGroups: { title: string; steps: { n: string; color: string; title: string; body: string }[] }[] = [
  {
    title: "Ship an app",
    steps: [
      { n: "1", color: flow.app, title: "Push", body: "An engineer builds and runs the image locally with Docker, pushes a branch to the app repo in Azure Repos and opens a pull request. Branch policies require a review and a green build before anything merges, and push protection rejects any push that contains a detected secret." },
      { n: "2", color: flow.app, title: "Trigger CI", body: "An Azure DevOps service hook starts a Jenkins pipeline on every push." },
      { n: "3", color: flow.app, title: "Build and publish", body: "Jenkins agents build the image with Podman, rootless and without a daemon, run the tests, scan the image with Trivy, sign it with Cosign, push it to ECR and ACR, and publish the Helm chart to JFrog Artifactory. Builds fetch their npm, PyPI and Maven dependencies through Artifactory's remote repositories, a cached proxy of the public registries that JFrog Curation filters. The supply chain section below shows each gate." },
      { n: "4", color: flow.app, title: "Bump the tag", body: "After a merge to main, Jenkins commits the new image tag to the Helm values in the gitops repo. Nobody deploys by hand: a deployment is a commit." },
      { n: "5", color: flow.app, title: "Detect", body: "Argo CD polls the gitops repo, every three minutes by default, or gets a webhook, and compares what Git describes with what runs in each cluster." },
      { n: "6", color: flow.app, title: "Sync", body: "Argo CD pulls the chart from Artifactory, renders it with the values from the gitops repo and applies it to every cluster: the app clusters on EKS and AKS, and the website's own EKS cluster. The same mechanism installs the add-ons each cluster runs: Prometheus, the Datadog Agent, the OpenTelemetry Collector, the EDR sensor, the Teleport agent, Kyverno and the External Secrets Operator. Kyverno admits a pod only if its image carries a valid signature." },
      { n: "7", color: flow.app, title: "Pull", body: "Each cluster pulls the image from the registry of its own cloud. The External Secrets Operator copies the app's passwords and API keys from Secrets Manager or Key Vault into Kubernetes Secrets, so they never sit in Git." },
    ],
  },
  {
    title: "Change the infrastructure",
    steps: [
      { n: "8", color: flow.infra, title: "Plan", body: "Infrastructure changes are pull requests to the infra repo. Atlantis receives the webhook, runs terraform plan, checks the plan against Conftest policies and posts both results as comments on the PR." },
      { n: "9", color: flow.infra, title: "Apply", body: "Once the PR is approved, commenting atlantis apply runs terraform apply: networks, identities, clusters, registries, VMs and the S3 log archive. The Terraform state lives in S3 or Azure Blob Storage, with locking, so two applies never race." },
      { n: "10", color: flow.infra, title: "Configure", body: "Ansible configures what is not in Kubernetes: the VMs for the Jenkins controller and agents, the OpenVPN server and the Teleport SSH service, including their EDR sensor and syslog forwarding. Its inventory plugins list the VMs from the AWS and Azure APIs, and its roles are first tested on the laptop, on Vagrant VMs, through Vagrant's Ansible provisioner." },
    ],
  },
  {
    title: "Serve the website",
    steps: [
      { n: "11", color: flow.traffic, title: "Visit", body: "Visitors resolve the website through Cloudflare DNS and reach Cloudflare's edge, which caches static content, filters requests through its WAF and absorbs DDoS attacks." },
      { n: "12", color: flow.traffic, title: "Origin", body: "Cloudflare forwards the remaining requests to an AWS Network Load Balancer in front of Envoy Gateway, the Kubernetes Gateway API implementation built on Envoy, in the website's EKS cluster. Envoy accepts only Cloudflare's client certificate (authenticated origin pulls) and routes each request to the website pods." },
    ],
  },
  {
    title: "Collect logs, detect threats",
    steps: [
      { n: "13", color: flow.logs, title: "Collect", body: "Apps and Envoy send traces, metrics and logs in OTLP, OpenTelemetry's protocol, to the Collector in their cluster. The Collector writes logs to the S3 archive, metrics to Prometheus, and traces and metrics to Datadog." },
      { n: "14", color: flow.logs, title: "Archive", body: "VMs and the OpenVPN server send syslog over the private network, through an internal load balancer, to the Collector's syslog receiver, which archives it in S3 too. Cloudflare writes its logs to the same archive with Logpush, and AWS writes CloudTrail and VPC flow logs there." },
      { n: "15", color: flow.logs, title: "Index", body: "Splunk, the SIEM, reads the archive through the AWS add-on's SQS-based S3 input: S3 announces each new object on a queue, and Splunk fetches and indexes it." },
      { n: "16", color: flow.logs, title: "Analyse", body: "The Datadog Forwarder, a Lambda function triggered by new objects, ships the same logs into Datadog, next to the metrics and traces. Datadog also watches Argo CD through its Agent check, and JFrog Artifactory Cloud through its integration." },
      { n: "17", color: flow.logs, title: "Scan", body: "Wiz connects to both clouds with read-only roles, plus permission to snapshot disks, and scans those snapshots instead of running agents, then reports misconfigurations and vulnerabilities. Its findings reach Splunk through the Wiz add-on." },
      { n: "18", color: flow.logs, title: "Detect", body: "The EDR sensor on laptops, VMs and cluster nodes streams process, file and network events to the EDR console, which detects attacks and can isolate a machine. Its detections are forwarded to Splunk, where they meet the cloud logs." },
    ],
  },
  {
    title: "Operate",
    steps: [
      { n: "19", color: flow.ops, title: "Page", body: "Datadog monitors page the on-call engineer, and so does Alertmanager for the Prometheus rules. Splunk alerts go to the security team." },
      { n: "20", color: flow.ops, title: "VPN", body: "The internal UIs of Jenkins, Argo CD and Atlantis are not open to the internet: the engineer reaches them with OpenVPN, through the server in each cloud's network. Only the webhook endpoints that Azure DevOps calls are exposed, limited to its IP ranges." },
      { n: "21", color: flow.ops, title: "Log in", body: "For production, the engineer runs tsh login, signs in through Entra ID and gets short-lived certificates instead of long-lived SSH keys or kubeconfigs." },
      { n: "22", color: flow.ops, title: "Access", body: "Teleport's proxy forwards kubectl to the agent in each cluster and ssh to the VMs. Agents dial out to the proxy through reverse tunnels, so clusters and VMs need no open inbound port, and every session is recorded." },
    ],
  },
];

