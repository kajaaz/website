const stepGroups: { title: string; steps: { n: string; color: string; title: string; body: string }[] }[] = [
  {
    title: "Ship an app",
    steps: [
      { n: "1", color: flow.app, title: "Push", body: "An engineer builds and runs the image locally with Docker, pushes a branch to the app repo in Azure Repos and opens a pull request. Branch policies require a review and a green build before anything merges, and push protection rejects any push that contains a detected secret." },
      { n: "2", color: flow.app, title: "Trigger CI", body: "An Azure DevOps service hook starts a Jenkins pipeline on every push." },
      { n: "3", color: flow.app, title: "Build and publish", body: "Jenkins agents build the image with Podman, rootless and without a daemon, run the tests, scan the image with Trivy, sign it with Cosign, push it to ECR and ACR, and publish the Helm chart to JFrog Artifactory. Builds fetch their npm, PyPI and Maven dependencies through Artifactory's remote repositories, a cached proxy of the public registries that JFrog Curation filters. The supply chain section below shows each gate." },
      { n: "4", color: flow.app, title: "Bump the tag", body: "After a merge to main, Jenkins commits the new image tag to the Helm values in the gitops repo. Nobody deploys by hand: a deployment is a commit." },
      { n: "5", color: flow.app, title: "Detect", body: "Argo CD polls the gitops repo, every three minutes by default, or gets a webhook, and compares what Git describes with what runs in each cluster." },
      { n: "6", color: flow.app, title: "Sync", body: "Argo CD pulls the chart from Artifactory, renders it with the values from the gitops repo and applies it to every cluster: the app clusters on EKS and AKS, and the website's own EKS cluster. The same mechanism installs the add-ons each cluster runs: Prometheus, the Datadog Agent, the OpenTelemetry Collector, the EDR sensor, cloudflared, Kyverno and the External Secrets Operator. Kyverno admits a pod only if its image carries a valid signature." },
      { n: "7", color: flow.app, title: "Pull", body: "Each cluster pulls the image from the registry of its own cloud. The External Secrets Operator copies the app's passwords and API keys from Secrets Manager or Key Vault into Kubernetes Secrets, so they never sit in Git." },
    ],
  },
  {
    title: "Change the infrastructure",
    steps: [
      { n: "8", color: flow.infra, title: "Plan", body: "Infrastructure changes are pull requests to the infra repo. Atlantis receives the webhook, runs terraform plan, checks the plan against Conftest policies and posts both results as comments on the PR." },
      { n: "9", color: flow.infra, title: "Apply", body: "Once the PR is approved, commenting atlantis apply runs terraform apply: networks, identities, clusters, registries and VMs. The Terraform state lives in S3 or Azure Blob Storage, with locking, so two applies never race." },
      { n: "10", color: flow.infra, title: "Configure", body: "Ansible configures what is not in Kubernetes: the VMs for the Jenkins controller and agents, including their EDR sensor and syslog forwarding. Its inventory plugins list the VMs from the AWS and Azure APIs, and its roles are first tested on the laptop, on Vagrant VMs, through Vagrant's Ansible provisioner." },
    ],
  },
  {
    title: "Serve the website",
    steps: [
      { n: "11", color: flow.traffic, title: "Visit", body: "Visitors resolve the website through Cloudflare DNS and reach Cloudflare's edge, which caches static content, filters requests through its WAF and absorbs DDoS attacks." },
      { n: "12", color: flow.traffic, title: "Origin", body: "Cloudflare forwards the remaining requests to an AWS Network Load Balancer in front of Envoy Gateway, the Kubernetes Gateway API implementation built on Envoy, in the website's EKS cluster. Envoy accepts only Cloudflare's client certificate (authenticated origin pulls) and routes each request to the website pods." },
    ],
  },
  {
    title: "Collect logs, detect threats",
    steps: [
      { n: "13", color: flow.logs, title: "Collect", body: "Apps and Envoy send traces, metrics and logs in OTLP, OpenTelemetry's protocol, to the Collector agent in their cluster. The agent keeps metrics in the cluster's Prometheus and forwards everything to the Collector gateway of its cloud." },
      { n: "14", color: flow.logs, title: "Syslog", body: "VMs send syslog over the private network, through an internal load balancer, to the Collector's syslog receiver. Cloudflare pushes its HTTP, firewall and DNS logs straight to Datadog with Logpush." },
      { n: "15", color: flow.logs, title: "Route", body: "The gateway sends every log, metric and trace to Datadog, and only the security-relevant logs, such as sign-ins, Kubernetes audit events and network denials, to the SIEM, which bills by volume. The SIEM reads the cloud audit logs, CloudTrail and the Azure Activity Log, through its own cloud connectors." },
      { n: "16", color: flow.logs, title: "Analyse", body: "Datadog keeps the logs next to the metrics and traces, and also watches Argo CD through its Agent check, and JFrog Artifactory Cloud through its integration." },
      { n: "17", color: flow.logs, title: "Scan", body: "Wiz connects to both clouds with read-only roles, plus permission to snapshot disks, and scans those snapshots instead of running agents, then reports misconfigurations and vulnerabilities. Its findings go to the SIEM." },
      { n: "18", color: flow.logs, title: "Detect", body: "The EDR sensor on laptops, VMs and cluster nodes streams process, file and network events to the EDR console, which detects attacks and can isolate a machine. Its detections are forwarded to the SIEM, where they meet the security logs." },
    ],
  },
  {
    title: "Operate",
    steps: [
      { n: "19", color: flow.ops, title: "Page", body: "Datadog monitors page the on-call engineer, and so does Alertmanager for the Prometheus rules. SIEM alerts go to the security team." },
      { n: "20", color: flow.ops, title: "Zero Trust", body: "Nothing internal has a public address. cloudflared, in each cloud, opens outbound tunnels to Cloudflare. Cloudflare Access puts an Entra ID login and a per-app rule in front of the Jenkins, Argo CD and Atlantis UIs, and the WARP client on the laptop reaches private endpoints, such as the cluster APIs, through the same tunnels. Only the webhook endpoints that Azure DevOps calls are exposed, limited to its IP ranges." },
      { n: "21", color: flow.ops, title: "Log in", body: "For production, the engineer runs aws sso login or az login, signs in through Entra ID and gets credentials that expire within hours, instead of long-lived keys or kubeconfigs." },
      { n: "22", color: flow.ops, title: "Access", body: "kubectl turns those credentials into short-lived tokens: EKS access entries map IAM Identity Center roles to Kubernetes permissions, and AKS accepts Entra ID tokens through kubelogin. Shells on VMs go through SSM Session Manager on AWS and Azure Bastion on Azure, so no VM listens for SSH. Cluster audit logs and session logs reach the SIEM." },
    ],
  },
];

