---
// One box of the Cloud Backend diagrams. Styles live in the page (.cloud-svg, global).
export interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  cls: string;
  title: string;
  lines?: string[];
  logo?: string | string[];
  pill?: string;
  pillColor?: string;
  pillLogo?: string;
  center?: boolean;
}

const { x, y, w, h, cls, title, lines = [], logo, pill, pillColor, pillLogo, center } = Astro.props;

// Wordmarks need a wider slot than square icons.
const logoSize: Record<string, [number, number]> = {
  "splunk.svg": [46, 13],
  "amazonwebservices.svg": [28, 18],
};
const logos = (logo === undefined ? [] : Array.isArray(logo) ? logo : [logo]).map((f) => ({ f, wh: logoSize[f] ?? [20, 20] }));
const logosW = logos.reduce((s, l) => s + l.wh[0], 0) + Math.max(0, logos.length - 1) * 4;

const cx = x + w / 2;
// Tall boxes that only exist to collect arrows centre their text vertically.
const ty = center ? y + (h - (36 + Math.max(0, lines.length - 1) * 15)) / 2 - 12 : y;
// Title widths are estimated (Inter 600 at 13.5px), to centre logos + title as one group.
const groupW = logos.length ? logosW + 6 + title.length * 7.3 : 0;
let lx = cx - groupW / 2;
const placed = logos.map((l) => {
  const p = { ...l, x: lx };
  lx += l.wh[0] + 4;
  return p;
});
const titleX = cx - groupW / 2 + logosW + 6;
const pStart = cx - (14 + 4 + (pill ?? "").length * 6.1) / 2;
---

<g class={cls}>
  <rect x={x} y={y} width={w} height={h} rx="10" stroke-width="1.2" />
  {
    logos.length ? (
      <>
        {placed.map((l) => (
          <image href={`/logos/${l.f}`} x={l.x} y={ty + 22 - l.wh[1] / 2} width={l.wh[0]} height={l.wh[1]} />
        ))}
        <text class="th" x={titleX} y={ty + 22} dominant-baseline="central" style="font-size:13.5px">{title}</text>
      </>
    ) : (
      <text class="th" x={cx} y={ty + 22} text-anchor="middle" dominant-baseline="central" style="font-size:13.5px">{title}</text>
    )
  }
  {lines.map((l, i) => (
    <text class="ts" x={cx} y={ty + 42 + i * 15} text-anchor="middle" dominant-baseline="central" style="font-size:10.5px">{l}</text>
  ))}
  {
    pill && (
      <g>
        <rect x={cx - 48} y={y + h - 30} width="96" height="20" rx="10" fill="#ffffff" stroke={pillColor} stroke-width="1.2" />
        {pillLogo && <image href={`/logos/${pillLogo}`} x={pStart} y={y + h - 27} width="14" height="14" />}
        <text x={pStart + 18} y={y + h - 20} dominant-baseline="central" class="pill" fill={pillColor}>{pill}</text>
      </g>
    )
  }
</g>
